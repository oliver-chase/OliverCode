{
  "_comment": "The example of this machine's local config: where repos live and the private repos. Copy it to olivercode.local.json.",
  "repoRoot": "~/Developer/Repos",
  "allowOutside": [],
  "auditMode": "gated",
  "maxBuilders": 4,
  "privateRepos": {
    "notes": "~/path/to/a-private-repo"
  },
  "otherDeviceRepos": ["a-repo-that-lives-on-another-device"],
  "otherDeviceOwners": ["another-devices-github-org"],
  "allowedAuthors": ["your-github-login", "your-bot-login"],
  "skillsRoot": "~/path/to/skills",
  "liveCopies": {
    "~/path/a-running-bot-reads": "~/path/to/its-agent-copy"
  }
}
