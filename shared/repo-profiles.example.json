{
  "version": 4,
  "description": "EXAMPLE repo profiles \u2014 placeholder only. Copy this to local/repo-profiles.json (gitignored) and replace with your real fleet. Machine-readable repo profiles for enforcement routing, token policy, and keepalive configuration.",
  "profiles": {
    "example-app": {
      "name": "example-app",
      "type": "nextjs",
      "canonicalValidationCommand": "npm run typecheck",
      "finalAuthority": "next build",
      "keepalive": {
        "supabase": {
          "enabled": false
        },
        "cloudflare": {
          "enabled": false
        }
      },
      "supplementaryValidators": [],
      "preCommitGatesHook": ".githooks/pre-commit",
      "buildScript": "npm run build",
      "taskTypes": {
        "write_code": {
          "requiredEvidence": [
            "files_changed_on_disk",
            "validation_command_executed",
            "validation_result_captured",
            "commit_hash_on_success"
          ],
          "fastAudits": [
            "conflict_markers",
            "duplicate_symbols"
          ]
        },
        "write_doc": {
          "requiredEvidence": [
            "files_changed_on_disk",
            "commit_hash_on_success"
          ],
          "fastAudits": [
            "conflict_markers",
            "stale_references"
          ]
        }
      },
      "failurePolicy": {
        "onValidationFail": "STOP_AND_REPORT",
        "failStageRecorded": "exact_failing_stage"
      },
      "token_policy": {
        "ignore_globs": [
          "node_modules/**",
          ".next/**",
          "out/**",
          "coverage/**",
          "*.log",
          "tsconfig.tsbuildinfo"
        ],
        "doc_priority_hints": [
          "README.md",
          "CLAUDE.md",
          "docs/repo-structure-contract.md"
        ],
        "generated_artifact_dirs": [
          "node_modules",
          ".next",
          "out",
          "coverage"
        ]
      },
      "suites": []
    }
  }
}