{
  "version": 2,
  "status": "PROVISIONED",
  "status_note": "All template sources exist. core/templates/project/ is the single template home (see core/contracts/FRAMEWORK_BASELINE.md).",
  "githubActionsPolicy": {
    "mode": "manual_only",
    "reason": "GitHub Actions billing is currently blocked; managed repos must not auto-trigger workflows until billing is restored."
  },
  "requiredDirectories": [
    ".github/workflows",
    ".github/user-stories",
    "docs/tech-debt",
    "docs/product",
    ".githooks"
  ],
  "templatedFiles": [
    {
      "source": "core/templates/project/.github/workflows/qa-hygiene.yml",
      "target": ".github/workflows/qa-hygiene.yml",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/.github/workflows/governance-secrets-gate.yml",
      "target": ".github/workflows/governance-secrets-gate.yml",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/.github/workflows/dependency-review.yml",
      "target": ".github/workflows/dependency-review.yml",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/.github/CODEOWNERS",
      "target": ".github/CODEOWNERS",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/.github/pull_request_template.md",
      "target": ".github/pull_request_template.md",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/QUALITY_BASELINE.md",
      "target": "QUALITY_BASELINE.md",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/.github/user-stories/README.md",
      "target": ".github/user-stories/README.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/.github/user-stories/_index.md",
      "target": ".github/user-stories/_index.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/config/contracts/planning-doc-governance.json",
      "target": "config/contracts/planning-doc-governance.json",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/scripts/check-structure-contract.mjs",
      "target": "scripts/check-structure-contract.mjs",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/scripts/check-planning-doc-governance.py",
      "target": "scripts/check-planning-doc-governance.py",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/CLAUDE.md",
      "target": "CLAUDE.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/docs/repo-structure-contract.md",
      "target": "docs/repo-structure-contract.md",
