    },
    {
      "source": "core/templates/project/docs/product/README.md",
      "target": "docs/product/README.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/pre-commit",
      "target": ".githooks/pre-commit",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/pre-commit-private",
      "target": ".githooks/pre-commit-private",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/.env.example",
      "target": ".env.example",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/.secrets/README.md",
      "target": ".secrets/README.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/docs/README.md",
      "target": "docs/README.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/docs/SETUP_MODES.md",
      "target": "docs/SETUP_MODES.md",
