{
  "_comment": "The files olivercode bootstrap stamps into a project repo, each with its target and mode.",
  "requiredDirectories": [
    ".githooks"
  ],
  "templatedFiles": [
    {
      "source": "core/templates/project/.github/CODEOWNERS",
      "target": ".github/CODEOWNERS",
      "mode": "offered"
    },
    {
      "source": "core/templates/project/QUALITY_BASELINE.md",
      "target": "QUALITY_BASELINE.md",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/scripts/check-structure-contract.mjs",
      "target": "scripts/check-structure-contract.mjs",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/CLAUDE.md",
      "target": "CLAUDE.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/docs/repo-structure-contract.md",
      "target": "docs/repo-structure-contract.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/pre-commit",
      "target": ".githooks/pre-commit",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/commit-msg",
      "target": ".githooks/commit-msg",
      "mode": "strict"
    },
    {
      "source": "core/templates/project/.env.example",
      "target": ".env.example",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/.secrets/README.md",
      "target": ".secrets/README.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/scripts/validate.sh",
      "target": "scripts/validate.sh",
      "mode": "presence"
    },
    {
      "source": "shared/backlog-config.example.json",
      "target": "docs/backlog-config.json",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/docs/SIZE-BASELINE.json",
      "target": "docs/SIZE-BASELINE.json",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/docs/IDENTIFIER-GATE.json",
      "target": "docs/IDENTIFIER-GATE.json",
      "mode": "presence"
    },
    {
      "source": "skills/audit/scripts/size.sh",
      "target": "scripts/size.sh",
      "mode": "strict"
    },
    {
      "source": "scripts/lib/duplication_check.py",
      "target": "scripts/duplication_check.py",
      "mode": "strict"
    }
  ]
}
