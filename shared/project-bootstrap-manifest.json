    },
    {
      "source": "core/templates/project/docs/MANUAL_SETUP.md",
      "target": "docs/MANUAL_SETUP.md",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/scripts/bootstrap-profile.sh",
      "target": "scripts/bootstrap-profile.sh",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/scripts/run-profile-checks.sh",
      "target": "scripts/run-profile-checks.sh",
      "mode": "presence"
    },
    {
      "source": "core/templates/project/docs/BACKLOG-live-tracker.md",
      "target": "docs/BACKLOG-live-tracker.md",
