#!/usr/bin/env python3
"""OliverCode terminal launcher.

The Python CLI behind `olivercode <command>` (see docs/SETUP.md, "Launcher commands").
Self-locating from __file__: every path derives from this file's location, so there
are no hardcoded vault/home/container paths and it runs identically from cron, a
container, or any working directory.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.repo_profiles import load_repo_profiles, registry_file, registry_gap  # noqa: E402
from lib.repo_profiles import resolve_repo_path as _resolve_repo_path  # noqa: E402
from lib.repo_profiles import iter_fleet as _iter_fleet  # noqa: E402
from lib.skills_catalog import _load_skills  # noqa: E402
from lib.health_checks import (  # noqa: E402,F401
    _check_waiver_expiry, _check_github_about,
    _check_vault_skill_links, _check_remotes_resolve, _check_oversized_tracked,
    _check_voice_copies, _check_scheduler,
)
from lib import backlog_setup as _backlog_setup  # noqa: E402
from lib import claude_settings as _claude_settings  # noqa: E402
from lib import repo_gates as _repo_gates  # noqa: E402
from lib.local_config import private_repos as _private_repos  # noqa: E402
from lib.local_config import skills_root as _skills_root  # noqa: E402
from lib.local_config import push_repos as _push_repos  # noqa: E402

# This file lives at <OliverCode>/scripts/olivercode, so the repo root is two up.
# Nothing else is hardcoded.
OC_ROOT = Path(__file__).resolve().parent.parent

COMMANDS = [
    ("olivercode bootstrap DIR [--dry-run]", "Stamp the project template into a repo, per the bootstrap manifest"),
    ("olivercode backlog-setup [DIR] [--apply]", "Set up or repair a repo's GitHub Project board, backlog config, commit-msg hook and story rule. Dry run unless --apply"),
    ("olivercode discover --root DIR", "Scan for git repos and report what governance they already have"),
    ("olivercode install", "Symlink CLAUDE.md, VOICE.md + skills into ~/.claude and add its hooks to settings.json (backs up anything it replaces)"),
    ("olivercode uninstall", "Remove the links and settings.json hooks install wrote, restoring what it backed up"),
    ("olivercode health [--root DIR] [--hooks-only]", "Run health checks: Claude Code hooks, placement drift. --hooks-only checks just the fleet hooks and makes no network call"),
    ("olivercode update", "Pull this checkout's tracking branch, re-run install, then sync fleet hooks"),
    ("olivercode sync-hooks [--root DIR]", "Converge hooks + core.hooksPath across the fleet and the private repos"),
    ("olivercode audit-fleet", "Run the audit skill's 3 static checks against this machine's skills folder + OliverCode's own skills"),
    ("olivercode push-fleet [--dry-run]", "Push already-committed work for OliverCode, the private repos and this machine's pushRepos, unattended"),
    ("olivercode skills [--grep TERM]", "List every skill in skills/, optionally filtered by name/description"),
]


def print_usage() -> None:
    print("OliverCode Terminal Launcher\n")
    print("Commands:")
    for cmd, desc in COMMANDS:
        print(f"  {cmd:<32} {desc}")


def command_skills(argv: list[str]) -> int:
    """List every skill under skills/, optionally filtered by --grep TERM."""
    term = None
    rest = list(argv)
    if "--grep" in rest:
        idx = rest.index("--grep")
        if idx + 1 >= len(rest):
            print("Error: --grep requires a search term.")
            return 1
        term = rest[idx + 1].lower()
        del rest[idx : idx + 2]
    _reject_extra("skills", rest)

    skills = _load_skills(OC_ROOT)
    if not skills:
        print("No skills found under skills/.")
        return 1

    if term:
        skills = [(n, d) for n, d in skills if term in n.lower() or term in d.lower()]
        if not skills:
            print(f"No skills match '{term}'.")
            return 0

    width = max((len(n) for n, _ in skills), default=0)
    for name, description in skills:
        summary = description if len(description) <= 100 else description[:97] + "..."
        print(f"{name:<{width}}  {summary}")
    print(f"\n{len(skills)} skill(s).")
    return 0


def _report_claude_dir(oc_root: Path) -> None:
    """Inventory ~/.claude, classifying what is OliverCode's and what is not.

    An existing setup accumulates a mix: symlinks into this checkout, symlinks into
    somewhere else entirely, real directories holding untracked content, and broken
    links pointing at things that moved. `install` only manages the first kind and
    deliberately leaves the rest alone -- which is safe, but silent. Adoption needs the
    full picture, because the foreign and real entries are exactly the ones a human has
    to make a decision about.
    """
    claude_dir = Path.home() / ".claude"
    print("\n~/.claude inventory")
    print("-" * 40)
    if not claude_dir.is_dir():
        print("  not present — `olivercode install` creates it")
        return

    rules = claude_dir / "CLAUDE.md"
    if rules.is_symlink():
        target = rules.resolve()
        owner = "OliverCode" if str(target).startswith(str(oc_root)) else f"elsewhere -> {target}"
        print(f"  CLAUDE.md   symlink ({owner})")
    elif rules.is_file():
        print("  CLAUDE.md   REAL FILE — `install` will back it up, not overwrite it")
    else:
        print("  CLAUDE.md   absent")

    skills_dir = claude_dir / "skills"
    if not skills_dir.is_dir():
        print("  skills/     absent")
        return

    ours, foreign, real, broken = [], [], [], []
    for entry in sorted(skills_dir.iterdir()):
        if entry.name.startswith("."):
            continue
        if entry.is_symlink():
            if not entry.exists():
                broken.append(entry.name)
            elif str(entry.resolve()).startswith(str(oc_root)):
                ours.append(entry.name)
            else:
                foreign.append((entry.name, entry.resolve()))
        elif entry.is_dir():
            real.append(entry.name)

    print(f"  skills/     {len(ours)} linked to this checkout, {len(foreign)} linked elsewhere, "
          f"{len(real)} real dirs, {len(broken)} broken")
    if foreign:
        print("\n  Symlinked outside this checkout — fine if deliberate (personal/business")
        print("  skills belong in your own area per docs/RULES.md):")
        for name, target in foreign:
            print(f"    {name} -> {target}")
    if real:
        print("\n  Real directories, untracked by any repo. `install` does NOT touch these.")
        print("  Vendor skills are the usual reason; anything else is content with no backup:")
        for name in real:
            print(f"    {name}")
    if broken:
        print("\n  BROKEN — the target moved or was deleted. `olivercode health` FAILs on these:")
        for name in broken:
            print(f"    {name}")


def command_discover(oc_root: Path, roots: list[Path]) -> int:
    """Find git repos under the given roots and report what governance they already have.

    Adoption docs assume you know where your repos are. Someone folding this into an
    existing, un-tidy setup often does not: repos spread over several directories,
    agent-rules files under three different names, hooks installed in some places and
    not others. This is the inventory step made mechanical -- read-only, and it emits
    a profile skeleton with explicit `path` values so a scattered layout is registrable
    without hand-writing JSON.
    """
    print("OliverCode discover — read-only scan")
    print("=" * 40)
    found: list[tuple[str, Path, str, str]] = []
    for root in roots:
        for git_dir in sorted(root.rglob(".git")):
            repo = git_dir.parent
            # Don't descend into vendored or nested-checkout noise.
            if any(part in {"node_modules", ".next", "vendor", "worktrees"} for part in repo.parts):
                continue
            if repo.resolve() == oc_root.resolve():
                continue  # the framework repo governs the fleet; it is not part of it
            rules = next((n for n in ("CLAUDE.md", "AGENTS.md", ".cursorrules") if (repo / n).is_file()), "none")
            hooks = subprocess.run(
                ["git", "-C", str(repo), "config", "--get", "core.hooksPath"],
                capture_output=True, text=True,
            ).stdout.strip() or "unset"
            found.append((repo.name, repo, rules, hooks))

    if not found:
        print("  No git repositories found under: " + ", ".join(str(r) for r in roots))
        return 1

    width = max(len(n) for n, _, _, _ in found)
    for name, repo, rules, hooks in found:
        flag = "" if hooks != "unset" else "   <- ungoverned: git runs no hooks here"
        print(f"  {name:<{width}}  rules={rules:<12} hooksPath={hooks}{flag}")

    print(f"\n{len(found)} repo(s). Rules files named anything other than CLAUDE.md do not")
    print("auto-load in Claude Code — merge them into CLAUDE.md (docs/SETUP.md Step 4).")

    _report_claude_dir(oc_root)
    print(f"\nProfile skeleton — paste into {registry_file(oc_root, 'repo-profiles.json')} under \"profiles\",")
    print("and replace <command> with each repo's validation command:\n")
    skeleton = {
        name: {"name": name, "path": str(repo), "canonicalValidationCommand": "<command>"}
        for name, repo, _, _ in found
    }
    print(json.dumps(skeleton, indent=2))
    return 0


def command_bootstrap(oc_root: Path, target: Path, dry_run: bool) -> int:
    """Stamp the project template into a repo, per shared/project-bootstrap-manifest.json.

    The manifest declared 27 templated files and 5 required directories and NOTHING read
    it -- `sync-hooks` covered the two hook files and every other file was a hand-copy.
    README claimed a new repo "starts compliant on day one"; this is what makes that true.

    Honours the manifest's modes: `strict` files are overwritten (their contract is
    byte-identity with the template), `presence` files are only created when missing so
    repo-specific content is never clobbered.
    """
    manifest_path = oc_root / "shared" / "project-bootstrap-manifest.json"
    if not manifest_path.is_file():
        print(f"  [FAIL] manifest not found: {manifest_path}")
        return 1
    manifest = json.loads(manifest_path.read_text())

    if not (target / ".git").exists():
        print(f"  [FAIL] {target} is not a git repository.")
        print("         Run `git init` there first — the hooks need a real .git.")
        return 1

    label = "DRY RUN — nothing written" if dry_run else f"stamping into {target}"
    print(f"OliverCode bootstrap — {label}")
    print("=" * 40)

    made_dirs = []
    for rel in manifest.get("requiredDirectories", []):
        d = target / rel
        if not d.is_dir():
            made_dirs.append(rel)
            if not dry_run:
                d.mkdir(parents=True, exist_ok=True)
    if made_dirs:
        print(f"  directories: {', '.join(made_dirs)}")

    new = overwritten = kept = 0
    missing_src = []
    for entry in manifest.get("templatedFiles", []):
        src, dst_rel, mode = oc_root / entry["source"], entry["target"], entry.get("mode", "presence")
        dst = target / dst_rel
        if not src.is_file():
            missing_src.append(entry["source"])
            continue
        exists = dst.exists()
        if exists and mode == "presence":
            kept += 1
            continue
        action = "OVERWRITE" if exists else "NEW"
        if exists:
            overwritten += 1
        else:
            new += 1
        print(f"  [{action:<9}] {dst_rel}" + (f"   ({mode})" if exists else ""))
        if not dry_run:
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_bytes(src.read_bytes())
            if src.suffix == ".sh" or dst_rel.startswith(".githooks/"):
                dst.chmod(0o755)

    print(f"\n  {new} new, {overwritten} overwritten (strict), {kept} kept (presence, already present)")
    for rel in missing_src:
        print(f"  [FAIL] template source missing from this checkout: {rel}")

    if dry_run:
        print("\nRe-run without --dry-run to apply.")
    else:
        print("\nNext: `olivercode sync-hooks` installs the hooks and sets core.hooksPath,")
        print("then fill in the placeholders in docs/repo-structure-contract.md.")
    return 1 if missing_src else 0


BACKUP_SUFFIX = ".pre-olivercode"


def _backups(path: Path) -> list[Path]:
    """Install's backups of path, oldest first: `<name>.pre-olivercode`, then `.2`, `.3`..."""
    if not path.parent.is_dir():
        return []
    found = []
    for b in path.parent.iterdir():
        if not b.name.startswith(path.name + BACKUP_SUFFIX):
            continue
        rest = b.name[len(path.name + BACKUP_SUFFIX):]
        if rest == "" or (rest[:1] == "." and rest[1:].isdigit()):
            found.append((int(rest[1:]) if rest else 1, b))
    return [b for _, b in sorted(found)]


INSTALL_RECORD = ".olivercode-install.json"


def _managed_links(oc_root: Path) -> dict[str, Path]:
    """Each link install makes, as its path under ~/.claude -> its source relative to the checkout."""
    links = {"CLAUDE.md": Path("CLAUDE.md"), "VOICE.md": Path("docs") / "VOICE.md"}
    for skill in sorted(p for p in (oc_root / "skills").iterdir() if (p / "SKILL.md").is_file()):
        links[f"skills/{skill.name}"] = Path("skills") / skill.name
    return links


def _read_record(claude_dir: Path) -> dict | None:
    """The links the last install wrote, as path under ~/.claude -> stored target. None when
    no install has written a record; an unreadable record counts as recording nothing."""
    path = claude_dir / INSTALL_RECORD
    if not path.is_file():
        return None
    try:
        links = json.loads(path.read_text()).get("links", {})
    except (OSError, ValueError, AttributeError):
        return {}
    return links if isinstance(links, dict) else {}


def _write_record(claude_dir: Path, links: dict[str, str]) -> None:
    path = claude_dir / INSTALL_RECORD
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps({"links": links}, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)


def _dangling_from_install(claude_dir: Path, oc_root: Path) -> set[str]:
    """The links under ~/.claude that dangle and that an OliverCode install wrote, as after the
    checkout moved. A dangling link alone proves nothing: it may point at a drive that is not
    mounted. The install record decides when there is one. For an install made before the
    record existed, two or more of install's links must dangle into the same folder, laid out
    the way a checkout is."""
    record = _read_record(claude_dir)
    managed = _managed_links(oc_root)
    dangling = {k: claude_dir / k for k in managed
                if (claude_dir / k).is_symlink() and not (claude_dir / k).exists()}
    if record is not None:
        return {k for k, link in dangling.items() if os.readlink(link) == record.get(k)}
    bases = {}
    for k, link in dangling.items():
        rel = managed[k]
        stored = Path(os.readlink(link))
        stored = stored if stored.is_absolute() else link.parent / stored
        if stored.parts[-len(rel.parts):] == rel.parts:
            bases[k] = Path(*stored.parts[:-len(rel.parts)])
    counts = {b: list(bases.values()).count(b) for b in bases.values()}
    return {k for k, b in bases.items() if counts[b] >= 2}


def command_install(oc_root: Path) -> int:
    """Activate this checkout: symlink CLAUDE.md, the voice and every skill into ~/.claude.

    This is the step that makes the rules load in every session from any directory.
    Doing it by hand is four commands and fails silently in two ways -- `ln` into a
    missing ~/.claude/skills dies with a bare "No such file or directory", and
    replacing an existing real CLAUDE.md destroys rules the operator may not have
    copied anywhere yet.

    Never destructive: a real file or any other link at a target path, a dangling one or
    one into another OliverCode checkout included, is moved aside to `<name>.pre-olivercode`
    and the path is reported, because that file is usually the operator's entire
    accumulated ruleset and docs/SETUP.md Step 3 exists to merge it back in
    deliberately. Only a link an OliverCode install wrote that now dangles, because its
    checkout moved, is replaced in place. `uninstall` restores the backup. Install records
    the links it wrote in ~/.claude/.olivercode-install.json so uninstall need not guess.
    """
    claude_dir = Path.home() / ".claude"
    skills_dir = claude_dir / "skills"
    print("OliverCode install — activating this checkout in ~/.claude")
    print("=" * 40)

    # A plain file sitting where a directory belongs is rare but real, and an unhandled
    # FileExistsError traceback is a poor first impression from the first command a fork
    # runs. Say what is wrong and what to do about it.
    for needed in (claude_dir, skills_dir):
        if needed.exists() and not needed.is_dir():
            print(f"  [FAIL] {needed} exists but is not a directory.")
            print("         Move or remove it, then re-run `olivercode install`.")
            return 1
    skills_dir.mkdir(parents=True, exist_ok=True)
    backups: list[str] = []
    moved_links = _dangling_from_install(claude_dir, oc_root)

    def _link(target: Path, source: Path) -> str:
        """Point target at source. Returns a one-word status."""
        if target.is_symlink():
            if target.resolve() == source.resolve():
                return "already"
            if str(target.relative_to(claude_dir)) in moved_links:
                target.unlink()
                target.symlink_to(source)
                return "relinked"
        if target.exists() or target.is_symlink():
            # BACKUP-COLLISION-1: rename() overwrites an existing destination on POSIX,
            # so a fixed two-name fallback silently destroyed the second backup on a
            # third real-file collision at the same path -- contradicts "never
            # destructive". Keep counting until a free name is found instead.
            backup = target.with_name(target.name + BACKUP_SUFFIX)
            n = 1
            while backup.exists() or backup.is_symlink():  # a backed-up link may dangle
                n += 1
                backup = target.with_name(f"{target.name}.pre-olivercode.{n}")
            target.rename(backup)
            backups.append(str(backup))
            target.symlink_to(source)
            return "backed-up"
        target.symlink_to(source)
        return "linked"

    status = _link(claude_dir / "CLAUDE.md", oc_root / "CLAUDE.md")
    print(f"  [{status.upper()}] ~/.claude/CLAUDE.md")
    # CLAUDE.md imports the voice by this fixed path. A relative import from a symlinked
    # CLAUDE.md has no documented base directory, so it could silently load nothing.
    status = _link(claude_dir / "VOICE.md", oc_root / "docs" / "VOICE.md")
    print(f"  [{status.upper()}] ~/.claude/VOICE.md")

    linked = already = 0
    for skill in sorted(p for p in (oc_root / "skills").iterdir() if (p / "SKILL.md").is_file()):
        result = _link(skills_dir / skill.name, skill)
        if result == "already":
            already += 1
        else:
            linked += 1
    print(f"  [OK] skills: {linked} linked, {already} already correct")
    # A skill this checkout removed leaves its link dangling into the checkout's own skills folder.
    # Install wrote that link, so install removes it.
    retired = sorted(p.name for p in skills_dir.iterdir() if p.is_symlink() and not p.exists()
                     and Path(os.readlink(p)) == oc_root / "skills" / p.name)
    for name in retired:
        (skills_dir / name).unlink()
    if retired:
        print(f"  [REMOVED] links to skills this checkout no longer has: {', '.join(retired)}")
    _write_record(claude_dir, {k: os.readlink(claude_dir / k) for k, rel in _managed_links(oc_root).items()
                               if (claude_dir / k).is_symlink() and (claude_dir / k).resolve() == (oc_root / rel).resolve()})

    # The Claude Code hooks are what hold the rules in every session, so install owns
    # them like the links above; claude_settings leaves the operator's own keys alone.
    broken_settings = False
    try:
        result = _claude_settings.install(claude_dir / "settings.json")
        print(f"  [{result.upper()}] Claude Code hooks in ~/.claude/settings.json")
    except ValueError as exc:  # invalid JSON, or a shape the merge would have to guess at
        print(f"  [FAIL] ~/.claude/settings.json could not be merged ({exc}); left as it is, hooks not installed")
        broken_settings = True

    broken = sorted(p.name for p in skills_dir.iterdir() if p.is_symlink() and not p.exists())
    if broken:
        print(f"  [FAIL] broken symlinks in ~/.claude/skills/: {', '.join(broken)}")

    untouched = sorted(
        p.name for p in skills_dir.iterdir()
        if p.name and not p.name.startswith(".")
        and not (p.is_symlink() and p.exists() and str(p.resolve()).startswith(str(oc_root)))
    )
    if untouched:
        print(f"  [KEPT] {len(untouched)} entr(y/ies) not managed by this checkout, left as-is: "
              f"{', '.join(untouched)}")
        print("         `olivercode discover --root <dir>` classifies them.")

    print()
    if backups:
        print("Backed up, NOT deleted — merge these in deliberately, they are usually")
        print("the rules you already had (docs/SETUP.md Step 3):")
        for b in backups:
            print(f"  {b}")
        print()
    print(f"Next: register the repo in {registry_file(oc_root, 'repo-profiles.json')}, then `olivercode health` to verify.")
    return 1 if broken or broken_settings else 0


def command_uninstall(oc_root: Path) -> int:
    """Undo `install`: remove what it wrote in ~/.claude and nothing else.

    A link is removed when it points into this checkout, or when it dangles and an
    OliverCode install wrote it (a checkout that moved), by the install record or, for an
    older install, by corroboration (see _dangling_from_install). Every other link stays,
    and so does a link into another live checkout. The install record goes too.
    The newest `<name>.pre-olivercode` backup install made is moved back once its path is
    free, and any older one is listed. The hook entries come out of settings.json by the
    same rule install uses to replace them, and every other key stays. Idempotent.

    `core.hooksPath` and each repo's `.githooks/` come from `sync-hooks`, not install,
    so they stay; docs/SETUP.md "Backing out" covers them.
    """
    claude_dir = Path.home() / ".claude"
    skills_dir = claude_dir / "skills"
    root = oc_root.resolve()
    moved_links = _dangling_from_install(claude_dir, oc_root) if claude_dir.is_dir() else set()
    print("OliverCode uninstall — removing what install wrote in ~/.claude")
    print("=" * 40)

    def _points_into(link: Path, base: Path) -> bool:
        # resolve() follows a link whose target is gone as far as it can, so a skill
        # deleted from the checkout after install still reads as this checkout's.
        target = link.resolve()
        return target == base or target.is_relative_to(base)

    def _restore(path: Path) -> bool:
        backups = _backups(path)
        if backups and not (path.exists() or path.is_symlink()):
            backups[-1].rename(path)  # the newest is what sat here right before the last install
            return True
        return False

    for name, rel in (("CLAUDE.md", Path("CLAUDE.md")), ("VOICE.md", Path("docs") / "VOICE.md")):
        path, note = claude_dir / name, ""
        if path.is_symlink() and (_points_into(path, (root / rel).resolve()) or name in moved_links):
            if not path.exists():
                note = f" (it pointed at {os.readlink(path)}, which is gone)"
            path.unlink()
            status = "restored" if _restore(path) else "removed"
        elif _restore(path):
            status = "restored"
        elif path.exists() or path.is_symlink():
            status, note = "kept", " (it is not a link install wrote)"
        else:
            status = "absent"
        print(f"  [{status.upper()}] ~/.claude/{name}{note}")

    removed = dangling = restored = 0
    if skills_dir.is_dir():
        for entry in sorted(skills_dir.iterdir()):
            if not entry.is_symlink():
                continue
            ours = _points_into(entry, root / "skills")
            moved = not ours and f"skills/{entry.name}" in moved_links
            if ours or moved:
                entry.unlink()
                removed += 1
                dangling += moved
        bases = {b.name.split(BACKUP_SUFFIX)[0] for b in skills_dir.iterdir() if BACKUP_SUFFIX in b.name}
        restored = sum(_restore(skills_dir / base) for base in sorted(bases))
    moved_note = f" ({dangling} of them dangling from a checkout that moved)" if dangling else ""
    print(f"  [OK] skills: {removed} link(s) removed{moved_note}, {restored} backup(s) restored")

    broken_settings = False
    try:
        result = _claude_settings.remove(claude_dir / "settings.json")
        print(f"  [{result.upper()}] Claude Code hooks in ~/.claude/settings.json")
    except ValueError as exc:
        print(f"  [FAIL] ~/.claude/settings.json could not be read ({exc}); left as it is, hooks not removed")
        broken_settings = True

    leftovers = [b for name in ("CLAUDE.md", "VOICE.md") for b in _backups(claude_dir / name)]
    if skills_dir.is_dir():
        leftovers += sorted(b for b in skills_dir.iterdir() if BACKUP_SUFFIX in b.name)
    (claude_dir / INSTALL_RECORD).unlink(missing_ok=True)
    print()
    if leftovers:
        print("Older backups left in place. An earlier install made each one, or something")
        print("now sits at its original path. Merge them back deliberately:")
        for b in leftovers:
            print(f"  {b}")
        print()
    if (claude_dir / f"skills{BACKUP_SUFFIX}").exists():
        print(f"~/.claude/skills{BACKUP_SUFFIX} is your own copy from docs/SETUP.md Step 2; uninstall leaves it.")
        print()
    print("Next: unset core.hooksPath in each governed repo (docs/SETUP.md \"Backing out\").")
    return 1 if broken_settings else 0


class _HealthTally:
    """Accumulates health-check results.

    WARN does not fail the run, on purpose: a standalone clone missing local-only
    context (control plane, private repos) must still exit 0 (see docs/RULES.md).

    It is counted SEPARATELY from OK all the same. Folding the two together printed
    "HEALTHY — 8/8 checks passed" on a run where five of the eight had been skipped
    for missing context and only three had actually verified anything. Nothing was
    wrong, but the summary claimed evidence it did not have, which is the same shape
    as every other defect this repo has had to dig out (scripts/lib/falsifiability_check.py).
    """

    def __init__(self) -> None:
        self.passed = 0
        self.skipped = 0
        self.failed = 0

    def ok(self, msg: str) -> None:
        print(f"  [OK] {msg}")
        self.passed += 1

    def warn(self, msg: str) -> None:
        print(f"  [WARN] {msg}")
        self.skipped += 1

    def fail(self, msg: str) -> None:
        print(f"  [FAIL] {msg}")
        self.failed += 1

    def add(self, passed: int, failed: int, skipped: int = 0) -> None:
        self.passed += passed
        self.failed += failed
        self.skipped += skipped

    def summary(self) -> str:
        """One line that never overstates what was checked."""
        if self.failed:
            return (f"UNHEALTHY — {self.failed} failed, {self.passed} passed"
                    + (f", {self.skipped} skipped" if self.skipped else ""))
        if self.skipped:
            return (f"HEALTHY — {self.passed} checks passed, {self.skipped} skipped for "
                    f"missing context (see WARN above); nothing failed")
        return f"HEALTHY — {self.passed} checks passed"


def command_health(fleet_root: Path | None = None, hooks_only: bool = False) -> int:
    """Run health checks: Claude Code hooks, control plane, placement drift.

    hooks_only checks just whether each fleet repo and private repo runs the right hooks. It
    reads local files, so it makes no network call and suits `validate.sh`.
    """
    if hooks_only:
        print("OliverCode fleet hooks")
        print("=" * 40)
        passed, failed, skipped = _check_fleet_hooks(OC_ROOT, fleet_root)
        print(f"\n{passed} passed, {failed} failed, {skipped} skipped")
        return 1 if failed else 0
    print("OliverCode Health Check")
    print("=" * 40)
    t = _HealthTally()

    # Claude Code hooks. Only a machine where install linked this checkout is expected
    # to carry them; a fresh clone or CI runner has not installed, which is a skip.
    print("\nClaude Code hooks:")
    claude_md = Path.home() / ".claude" / "CLAUDE.md"
    if not (claude_md.is_symlink() and claude_md.resolve() == (OC_ROOT / "CLAUDE.md").resolve()):
        t.warn("install has not linked this checkout on this machine — hooks not checked")
    else:
        lacking = _claude_settings.missing(Path.home() / ".claude" / "settings.json")
        if lacking:
            t.fail(f"~/.claude/settings.json lacks {', '.join(lacking)} for this checkout — run `olivercode install`")
        else:
            t.ok(f"all {len(_claude_settings.MANAGED)} OliverCode hooks are in ~/.claude/settings.json")

    # 2. The optional local control plane (runtime/control-plane/, gitignored). A machine
    # without one has nothing to check here, so its absence is not counted as a skip.
    control_plane = OC_ROOT / "runtime" / "control-plane"
    if not control_plane.exists():
        print("  [INFO] no local control plane on this machine — not checked")
    else:
        if (control_plane / "olivercode").exists():
            t.ok("runtime/control-plane/olivercode (launcher)")
        else:
            t.fail("runtime/control-plane/olivercode — control plane present but launcher missing")
        dep_file = control_plane / "OLIVERCODE_DEPENDENCY.md"
        if dep_file.exists():
            oc_dirs = ("shared/", "core/", "docs/", "scripts/", "tooling/", "runtime/", ".githooks/")
            text = dep_file.read_text(encoding="utf-8", errors="ignore")
            declared = [m for m in re.findall(r"`([^`]+)`", text) if m.startswith(oc_dirs)]
            missing = [rel for rel in declared if not (OC_ROOT / rel).exists()]
            if not declared:
                t.warn("no OliverCode-relative dependency paths declared")
            elif not missing:
                t.ok(f"all {len(declared)} declared dependency paths resolve")
            else:
                for rel in missing:
                    t.fail(f"{rel} — not found")

    # 3. Placement drift (spec: docs/RULES.md "Skill placement").
    # Everything here reads OUTSIDE OC_ROOT (private repos, sibling fleet repos), so it
    # must degrade to WARN, never FAIL, when that context isn't present — a standalone
    # clone with no private repos around it is still a valid, healthy checkout.
    passed, failed, skipped = _check_placement_drift(OC_ROOT, fleet_root)
    t.add(passed, failed, skipped)

    # 4. Governance exceptions that have run out.
    print("\nGovernance waivers:")
    passed, failed, skipped = _check_waiver_expiry(OC_ROOT)
    t.add(passed, failed, skipped)

    # 5. GitHub About. The documentation standard treats an empty About as missing
    # documentation; nothing else ever looks at it, so it rots invisibly.
    print("\nGitHub About:")
    passed, failed, skipped = _check_github_about(OC_ROOT)
    t.add(passed, failed, skipped)

    # 6. Topology. The gates cover what goes INTO a commit; these cover whether the
    # pieces are still wired together and recoverable. See health_checks.py for the
    # four failures that ran undetected because nothing looked.
    t.add(*_check_vault_skill_links(_skills_root()))
    t.add(*_check_voice_copies(OC_ROOT, Path.home() / ".claude" / "skills"))
    t.add(*_check_scheduler(Path.home()))

    # Repos to check for remote reachability and oversized files: the private repos,
    # this framework repo, and every fleet repo that exists on disk.
    topo_repos: list[tuple[str, Path]] = [(n, p) for n, p in _private_repos().items() if (p / ".git").exists()]
    topo_repos.append((OC_ROOT.name, OC_ROOT))
    _profiles, _ = load_repo_profiles(OC_ROOT)
    for name, _profile, repo_path in _iter_fleet(_profiles, fleet_root or OC_ROOT.parent):
        if repo_path.is_dir():
            topo_repos.append((name, repo_path))

    t.add(*_check_oversized_tracked(topo_repos))
    t.add(*_check_remotes_resolve(topo_repos))

    # 7. Each repo's board against shared/kanban-baseline.json, and its commit-msg hook.
    print("\nBacklog boards:")
    t.add(*_backlog_setup.boards_health(topo_repos, _backlog_setup.Api()))

    print(f"\n{'=' * 40}")
    print(t.summary())
    return 1 if t.failed else 0


def command_backlog_setup(argv: list[str]) -> int:
    """`olivercode backlog-setup [DIR] [--apply]`: see lib/backlog_setup.py and docs/SETUP.md."""
    apply = "--apply" in argv
    rest = [a for a in argv if a != "--apply"]
    opts: dict[str, list[str]] = {"--title": [], "--area": [], "--map": []}
    link = "--no-link" not in rest
    rest = [a for a in rest if a != "--no-link"]
    paths: list[str] = []
    i = 0
    while i < len(rest):
        if rest[i] in opts:
            if i + 1 >= len(rest):
                print(f"Error: {rest[i]} needs a value.")
                return 1
            opts[rest[i]].append(rest[i + 1])
            i += 2
        else:
            paths.append(rest[i])
            i += 1
    if len(paths) > 1 or (paths and paths[0].startswith("-")):
        print("Usage: olivercode backlog-setup [DIR] [--apply] [--title NAME] [--area NAME ...] [--map OLD=NEW ...] [--no-link]")
        return 1
    target = Path(paths[0] if paths else ".").expanduser()
    if not target.is_dir():
        print(f"Error: {target} is not a directory.")
        return 1
    return _backlog_setup.run_setup(target, apply, _backlog_setup.Api(), OC_ROOT,
                                    title=(opts["--title"] or [None])[-1], areas=opts["--area"] or None,
                                    maps=opts["--map"], link=link)


# _resolve_repo_path / _iter_fleet moved to lib/repo_profiles.py 2026-09-15 so
# find-spec.py could reuse fleet-repo resolution instead of a third copy. Imported
# under their original names below so `launcher._iter_fleet` etc. keep working for
# existing callers and tests.


def _hook_problems(repo_root: Path, templates_dir: Path, private_repo: bool) -> list[str]:
    """Return human-readable problems with a repo's live hooks, or [] when they match.

    `repo_gates.gate_problem` first catches every state where git runs none of the repo's
    gates: hooksPath unset or pointed away from `.githooks`, the folder or its pre-commit
    missing, or a pre-commit that is not executable. The live pre-commit must then match
    the one template this repo's variant names, so a public repo running the weaker private
    hook fails. pre-push and commit-msg must match their templates too, because sync-hooks deploys them.
    """
    gate = _repo_gates.gate_problem(repo_root)
    if gate:
        return [gate]

    hooks_dir = repo_root / ".githooks"
    expected = {"pre-commit": "pre-commit-private" if private_repo else "pre-commit",
                "pre-push": "pre-push", "commit-msg": "commit-msg"}
    if not private_repo:
        expected["pre-commit-private"] = "pre-commit-private"   # the inert reference copy

    problems = []
    for filename, template in expected.items():
        installed = hooks_dir / filename
        canonical = templates_dir / template
        if filename == "pre-commit-private" and not installed.exists():
            continue
        if not installed.is_file():
            problems.append(f"no {filename} in {hooks_dir}")
        elif not os.access(installed, os.X_OK):
            problems.append(f"{installed} is not executable, so git skips it")
        elif installed.read_bytes() != canonical.read_bytes():
            problems.append(f"{filename} diverges from the {template} template")

    return problems


def _check_placement_drift(oc_root: Path, fleet_root: Path | None = None) -> tuple[int, int, int]:
    print("\nPlacement drift (docs/RULES.md):")
    passed = 0
    failed = 0
    skipped = 0
    templates_dir = oc_root / "core" / "templates" / "project"

    # (a)/(b) Every OliverCode skill must have a live, correctly-targeted symlink at
    # ~/.claude/skills/<name> -- that's the mechanism making it invocable from any repo.
    # ~/.claude/skills/ is a real directory (not one whole-directory symlink) holding a
    # mix of individual symlinks (orchestration + personal) and real, untracked product/
    # GTM and vendor content -- only the symlinked half is checkable from here.
    claude_skills_dir = Path.home() / ".claude" / "skills"
    if not claude_skills_dir.is_dir():
        print("  [WARN] ~/.claude/skills/ not present — skipping")
        skipped += 1
    else:
        skills_dir = oc_root / "skills"
        oc_skill_names = sorted(
            p.name for p in skills_dir.iterdir() if p.is_dir() and (p / "SKILL.md").exists()
        ) if skills_dir.is_dir() else []
        installed, missing, wrong_target = [], [], []
        for name in oc_skill_names:
            link = claude_skills_dir / name
            expected = skills_dir / name
            if not link.is_symlink():
                missing.append(name)
            elif link.resolve() != expected.resolve():
                wrong_target.append(name)
            else:
                installed.append(name)
        if oc_skill_names and not installed:
            # Zero symlinks resolve into THIS checkout: it isn't the machine's installed
            # OliverCode (fresh clone, fork, or scratch copy). That's a valid state, not
            # drift -- G4 requires a stranger clone to report HEALTHY.
            print(f"  [WARN] this checkout is not the machine's installed OliverCode "
                  f"(no ~/.claude/skills/ symlinks point here) — to install, see docs/RULES.md")
            skipped += 1
        elif missing:
            print(f"  [FAIL] not symlinked at ~/.claude/skills/: {', '.join(missing)}")
            failed += 1
        elif wrong_target:
            print(f"  [FAIL] symlinked but pointing elsewhere: {', '.join(wrong_target)}")
            failed += 1
        else:
            print(f"  [OK] all {len(oc_skill_names)} OliverCode skills correctly symlinked at ~/.claude/skills/")
            passed += 1

        broken = sorted(
            p.name for p in claude_skills_dir.iterdir() if p.is_symlink() and not p.exists()
        )
        if broken:
            print(f"  [FAIL] broken symlinks in ~/.claude/skills/: {', '.join(broken)}")
            failed += 1
        else:
            passed += 1

    p, f, s = _check_fleet_hooks(oc_root, fleet_root)
    return passed + p, failed + f, skipped + s


def _check_fleet_hooks(oc_root: Path, fleet_root: Path | None = None) -> tuple[int, int, int]:
    """Check that every fleet repo and private repo runs the right hooks. Reads local files only.

    A repo that is both registered in the fleet and named in privateRepos is checked once, as a
    private repo, because sync-hooks deploys it that way.
    """
    passed = failed = skipped = 0
    templates_dir = oc_root / "core" / "templates" / "project"
    private = _private_repos()
    private_paths = {root.resolve() for root in private.values()}
    checked: set[Path] = set()
    # (c) Fleet repos: unset core.hooksPath, or a hook file diverging from the template.
    profiles, _ = load_repo_profiles(oc_root)
    fleet = list(_iter_fleet(profiles, fleet_root or oc_root.parent))
    gap = registry_gap(oc_root)
    if gap:
        # Private repos are named but none holds the registry, so every fleet check below would
        # pass on an empty fleet; a machine set up before the registry moved hits exactly this.
        print(f"  [FAIL] {gap}")
        failed += 1
    elif not fleet:
        print(f"  [WARN] no fleet registered in {registry_file(oc_root, 'repo-profiles.json')} — skipping hook-drift check")
        print("         If your registry lives in a private repo, name that repo under privateRepos in")
        print("         olivercode.local.json; OliverCode reads <repo>/olivercode/repo-profiles.json from it.")
        skipped += 1
    else:
        # A registered repo that is not cloned on this machine is not a defect here, so it
        # is listed once and not counted as a skipped check.
        absent = [name for name, _profile, repo_path in fleet if not (repo_path / ".git").exists()]
        if absent:
            print(f"  [INFO] not cloned on this machine: {', '.join(absent)}")
        for name, profile, repo_path in fleet:
            if name in absent:
                continue
            checked.add(repo_path.resolve())
            is_private = bool(profile.get("private")) or repo_path.resolve() in private_paths
            problems = _hook_problems(repo_path, templates_dir, is_private)
            variant = profile.get("hookVariant")
            if problems and variant:
                # A repo may legitimately need a hook the template cannot express (a
                # repo-specific governance path, a gate whose checker only exists there).
                # Declaring `hookVariant` in the profile says "this divergence is
                # considered" -- it is reported, not failed, and sync-hooks leaves it
                # alone. Divergence WITHOUT a declaration is still a failure, so this
                # cannot be used to quietly opt out of enforcement.
                # A variant only replaces pre-commit; sync-hooks still manages pre-push and commit-msg.
                fatal = [p for p in problems if not p.startswith("pre-commit")]
                if fatal:
                    print(f"  [FAIL] {name}: {'; '.join(fatal)}")
                    failed += 1
                else:
                    # WARN, not OK: a variant no longer receives the template's fixes, so
                    # each one has to be merged by hand and this line is the reminder.
                    print(f"  [WARN] {name}: declared hook variant ({variant}) — "
                          "template hook fixes must be merged into it by hand")
                    passed += 1
            elif problems:
                print(f"  [FAIL] {name}: {'; '.join(problems)}")
                failed += 1
            else:
                print(f"  [OK] {name}: hooksPath set, hooks match template")
                passed += 1

    # Private repos are managed hook targets too, checked against the private variant.
    if not private:
        print("  [INFO] no private repos set for this machine (privateRepos) — not checked")
    for name, root in private.items():
        if root.resolve() in checked:
            continue
        if not (root / ".git").exists():
            print(f"  [WARN] {name}: no .git at {root} — hook check skipped")
            skipped += 1
            continue
        problems = _hook_problems(root, templates_dir, private_repo=True)
        if problems:
            print(f"  [FAIL] {name}: {'; '.join(problems)}")
            failed += 1
        else:
            print(f"  [OK] {name}: hooksPath set, hooks match template")
            passed += 1

    return passed, failed, skipped


def _install_pre_push(repo_path: Path, templates_dir: Path) -> None:
    """Deploy pre-push and commit-msg. A declared pre-commit variant still gets both: what is
    safe to push and the story reference every commit carries do not depend on which commit
    gates a repo runs. A repo's `commit-msg.optout` file is never written or removed here."""
    for name in ("pre-push", "commit-msg"):
        _backlog_setup.deploy_hook(repo_path / ".githooks", templates_dir, name)


def _install_hook_pair(repo_path: Path, templates_dir: Path, private_repo: bool) -> None:
    """Idempotently deploy the hook template(s) + hooksPath config to one repo.

    A public repo gets the public template as its live `pre-commit`, plus the private
    variant beside it as an inert reference copy. A private repo (private_repo=True)
    gets the private template's content deployed AS `pre-commit`, because git only
    auto-invokes that exact filename.

    Also deploys `commit-msg` (story reference on every commit) and `pre-push` (force-push/history-rewrite block, secret scan on the push
    range). It has no public/private variant: what is safe to push does not differ by
    repo visibility the way commit-time PII checks do, and `push-fleet` needs
    the same mechanical gate on every repo it touches.

    A repo's own `.githooks/pre-commit.local` is never written here. The private
    hook runs it when it exists (GATE-LOCAL-1).

    docs/GATES.md holds the per-variant gate table.
    """
    hooks_dir = repo_path / ".githooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)

    live_source = templates_dir / ("pre-commit-private" if private_repo else "pre-commit")
    live_target = hooks_dir / "pre-commit"
    live_target.write_bytes(live_source.read_bytes())
    live_target.chmod(0o755)

    if not private_repo:
        reference_source = templates_dir / "pre-commit-private"
        reference_target = hooks_dir / "pre-commit-private"
        reference_target.write_bytes(reference_source.read_bytes())
        reference_target.chmod(0o755)

    _install_pre_push(repo_path, templates_dir)

    subprocess.run(["git", "-C", str(repo_path), "config", "core.hooksPath", ".githooks"], check=True)


def command_sync_hooks(oc_root: Path, fleet_root: Path | None = None) -> int:
    """Converge hooks + core.hooksPath across every fleet repo and every private repo.

    fleet_root defaults to OliverCode's parent (the sibling-repos layout). A fork whose
    repos live elsewhere passes --root; without that, every repo would silently SKIP as
    "not present on this machine" and the command would still report success.
    """
    templates_dir = oc_root / "core" / "templates" / "project"
    fleet_root = fleet_root or oc_root.parent
    updated = 0
    skipped = 0

    profiles, _ = load_repo_profiles(oc_root)
    for name, profile, repo_path in _iter_fleet(profiles, fleet_root):
        if not (repo_path / ".git").exists():
            print(f"  [SKIP] {name}: not present on this machine")
            skipped += 1
            continue
        variant = profile.get("hookVariant")
        if variant:
            # Declared variant: overwriting its pre-commit would destroy a considered customization.
            # `health` reports it as WARN rather than drift. Remove the profile field
            # to bring the repo back under the template.
            _install_pre_push(repo_path, templates_dir)
            print(f"  [SKIP] {name}: declared hook variant ({variant}) — pre-commit left untouched, pre-push and commit-msg synced")
            skipped += 1
            continue
        # A private repo gets the private variant, which drops the PII gate (it holds
        # personal data by design) and adds the archived-content gate. Declared per
        # profile rather than hardcoded: one private repo was the only private target
        # for a while, so the second one had its hook installed by hand and would have
        # gone stale on the next template change, silently.
        is_private = bool(profile.get("private"))
        _install_hook_pair(repo_path, templates_dir, private_repo=is_private)
        variant_note = "private-variant " if is_private else ""
        print(f"  [OK] {name}: {variant_note}hooks synced, hooksPath set")
        updated += 1

    for name, root in _private_repos().items():
        if (root / ".git").exists():
            _install_hook_pair(root, templates_dir, private_repo=True)
            print(f"  [OK] {name}: private-variant hook synced, hooksPath set")
            updated += 1
        else:
            print(f"  [SKIP] {name}: no .git at {root}")
            skipped += 1

    print(f"\n{updated} target(s) synced, {skipped} skipped.")
    return 0


def command_audit_fleet(oc_root: Path) -> int:
    """Run the audit skill's 3 static checks against every known skill root.

    Targets exactly 2 roots -- this machine's skills folder (local_config) and
    OliverCode's own skills/ -- not the fleet-repo iteration sync-hooks uses. Fleet
    iteration walks git repos for hook management; this walks 2 known skill-directory
    trees, a different job with a different unit. repo-profiles.json lists repos, which
    hold no skill trees, so reusing it here would scan the wrong places.

    Non-interactive: writes findings to a log file and prints one line per check,
    never fixes anything: a scheduled job with nobody watching never auto-fixes.
    The audit ships in this checkout, so it runs on any machine; the personal skills
    folder is checked only when this machine names one.
    """
    scripts_dir = oc_root / "skills" / "audit" / "scripts"
    if not scripts_dir.is_dir():
        print(f"Error: {scripts_dir} not found -- this checkout is missing skills/audit.")
        return 1

    targets = {"olivercode-skills": oc_root / "skills"}
    skills = _skills_root()
    if skills is None:
        print("  [INFO] no skills folder set for this machine (skillsRoot) — only OliverCode's skills are checked")
    else:
        targets = {"skills": skills, **targets}
    checks = ["check_skill_structure.py", "check_mcp_patterns.py", "check_descriptions.py"]

    # runtime/manifests/ is the sanctioned home for a generated observability
    # artifact -- runtime/control-plane/ specifically means the local control
    # plane install and trips a health check expecting its full shape (a
    # launcher shim) the moment anything creates a directory under it.
    log_dir = oc_root / "runtime" / "manifests" / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / "audit-fleet.log"
    log_lines = [f"=== audit-fleet run {datetime.now(timezone.utc).isoformat()} ==="]

    any_failed = False
    for target_name, target_path in targets.items():
        if not target_path.is_dir():
            print(f"  [SKIP] {target_name}: {target_path} not found")
            continue
        print(f"-- {target_name} ({target_path}) --")
        for check in checks:
            result = subprocess.run(
                ["python3", str(scripts_dir / check), str(target_path)],
                capture_output=True, text=True,
            )
            out_lines = result.stdout.strip().splitlines()
            summary = out_lines[-1] if out_lines else "(no output)"
            status = "FAIL" if result.returncode != 0 else "ok"
            if status == "FAIL":
                any_failed = True
            print(f"  [{status}] {check}: {summary}")
            log_lines.append(f"{target_name} {check}: {status} -- {summary}")

    log_path.write_text("\n".join(log_lines) + "\n", encoding="utf-8")
    print(f"\nFull output: {log_path}")
    print("Findings are heuristic. Read the flagged locations before treating any as a real "
          "defect -- this command never fixes anything on its own.")
    return 1 if any_failed else 0


def command_push_fleet(oc_root: Path, dry_run: bool) -> int:
    """Push already-committed work for OliverCode, the private repos and this machine's pushRepos.

    Scoped to repos named on purpose, for the lowest blast radius. The private repos and
    pushRepos come from local_config. A wider rollout needs
    its own opt-in (a per-repo repo-profiles.json flag), not a blanket expansion,
    and needs every target repo to actually carry the pre-push hook first (a repo
    with a declared hookVariant still has none -- see sync-hooks' own skip logic).

    Never commits anything. Skips, reports, and moves on for a repo with
    uncommitted changes or no upstream tracking branch. Each repo's own pre-push
    hook is the real safety gate here (secret scan, no force-push) -- this command
    only decides which repos to attempt, never overrides what that hook blocks.
    """
    targets = {"olivercode": oc_root, **_private_repos()}
    profiles, _ = load_repo_profiles(oc_root)
    for name in _push_repos():
        targets[name] = _resolve_repo_path(name, profiles.get(name, {}), oc_root.parent)

    failed = 0
    for name, repo_path in targets.items():
        if not (repo_path / ".git").exists():
            print(f"  [SKIP] {name}: no .git found at {repo_path}")
            continue
        status = subprocess.run(
            ["git", "-C", str(repo_path), "status", "--porcelain"],
            capture_output=True, text=True,
        )
        if status.stdout.strip():
            print(f"  [SKIP] {name}: uncommitted changes present -- never auto-committed")
            continue
        upstream = subprocess.run(
            ["git", "-C", str(repo_path), "rev-parse", "--abbrev-ref", "@{u}"],
            capture_output=True, text=True,
        )
        if upstream.returncode != 0:
            print(f"  [SKIP] {name}: no upstream tracking branch")
            continue
        ahead = subprocess.run(
            ["git", "-C", str(repo_path), "rev-list", "--count", "@{u}..HEAD"],
            capture_output=True, text=True,
        )
        count = int(ahead.stdout.strip() or "0")
        if count == 0:
            print(f"  [OK] {name}: up to date, nothing to push")
            continue
        if dry_run:
            print(f"  [DRY-RUN] {name}: would push {count} commit(s)")
            continue
        result = subprocess.run(["git", "-C", str(repo_path), "push"], capture_output=True, text=True)
        if result.returncode == 0:
            print(f"  [OK] {name}: pushed {count} commit(s)")
        else:
            err_lines = result.stderr.strip().splitlines()
            print(f"  [FAIL] {name}: push blocked -- {err_lines[-1] if err_lines else 'unknown error'}")
            failed += 1
    # Non-zero on any blocked push, so the scheduler leaves its marker and retries next tick.
    return 1 if failed else 0


def command_update() -> int:
    """Pull this checkout's tracking branch, re-run install, then converge fleet hooks.

    Install runs on every update because a pull can add a skill or a Claude Code hook,
    and only install links those into ~/.claude; without it a second device kept the
    files of a new skill with no link to them. Install and sync-hooks run as new
    processes, so they use the code the pull just brought in, never the copy this
    process loaded before it.

    On a fork `origin` is the FORK, so this does not fetch upstream framework changes.
    Pulling those is a deliberate act with real merge consequences -- a fork carries local
    edits to CLAUDE.md, contracts, and templates, which is the whole point of forking -- so
    it is documented in docs/SETUP.md ("Staying current") rather than automated here.
    """
    pull_code = subprocess.run(["git", "-C", str(OC_ROOT), "pull"]).returncode
    if pull_code != 0:
        return pull_code
    launcher = [sys.executable, str(OC_ROOT / "scripts" / "olivercode")]
    print()
    install_code = subprocess.run([*launcher, "install"]).returncode
    print()
    sync_code = subprocess.run([*launcher, "sync-hooks"]).returncode
    return install_code or sync_code


def _take_root_flag(argv: list[str]) -> tuple[Path | None, list[str]]:
    """Pull `--root <dir>` out of argv. Returns (root or None, remaining args)."""
    if "--root" not in argv:
        return None, argv
    idx = argv.index("--root")
    if idx + 1 >= len(argv):
        print("Error: --root requires a directory.")
        sys.exit(1)
    root = Path(argv[idx + 1]).expanduser()
    if not root.is_dir():
        print(f"Error: --root {root} is not a directory.")
        sys.exit(1)
    return root, argv[:idx] + argv[idx + 2:]


def _reject_extra(cmd: str, rest: list[str]) -> None:
    """Unknown arguments must fail loudly.

    Silently ignoring them is worse than rejecting them: `sync-hooks --root /somewhere`
    used to ignore the flag, sync the DEFAULT fleet, and print "6 targets synced" -- so a
    fork with a different layout got a success message for work done on the wrong repos.
    """
    if rest:
        print(f"Error: unexpected argument(s) for '{cmd}': {' '.join(rest)}")
        print_usage()
        sys.exit(1)


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in {"--help", "-h", "help"}:
        print_usage()
        return 0

    cmd = sys.argv[1]
    argv = sys.argv[2:]

    if cmd == "discover":
        roots: list[Path] = []
        rest = argv
        while "--root" in rest:
            root, rest = _take_root_flag(rest)
            roots.append(root)
        _reject_extra(cmd, rest)
        if not roots:
            print("Error: discover requires at least one --root DIR.")
            return 1
        return command_discover(OC_ROOT, roots)
    if cmd == "bootstrap":
        dry = "--dry-run" in argv
        rest = [a for a in argv if a != "--dry-run"]
        if len(rest) != 1:
            print("Usage: olivercode bootstrap <repo-path> [--dry-run]")
            return 1
        target = Path(rest[0]).expanduser()
        if not target.is_dir():
            print(f"Error: {target} is not a directory.")
            return 1
        return command_bootstrap(OC_ROOT, target, dry)
    if cmd == "backlog-setup":
        return command_backlog_setup(argv)
    if cmd == "install":
        _reject_extra(cmd, argv)
        return command_install(OC_ROOT)
    if cmd == "uninstall":
        _reject_extra(cmd, argv)
        return command_uninstall(OC_ROOT)

    if cmd == "health":
        hooks_only = "--hooks-only" in argv
        root, rest = _take_root_flag([a for a in argv if a != "--hooks-only"])
        _reject_extra(cmd, rest)
        return command_health(root, hooks_only)
    if cmd == "update":
        _reject_extra(cmd, argv)
        return command_update()
    if cmd == "sync-hooks":
        root, rest = _take_root_flag(argv)
        _reject_extra(cmd, rest)
        return command_sync_hooks(OC_ROOT, root)
    if cmd == "audit-fleet":
        _reject_extra(cmd, argv)
        return command_audit_fleet(OC_ROOT)
    if cmd == "push-fleet":
        dry = "--dry-run" in argv
        rest = [a for a in argv if a != "--dry-run"]
        _reject_extra(cmd, rest)
        return command_push_fleet(OC_ROOT, dry_run=dry)
    if cmd == "skills":
        return command_skills(argv)

    print(f"Error: '{cmd}' is not a valid command.")
    print_usage()
    return 1


if __name__ == "__main__":
    sys.exit(main())
