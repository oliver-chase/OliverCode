#!/usr/bin/env python3
"""OliverCode terminal launcher.

The Python CLI behind `olivercode <command>` (see docs/OLIVERCODE_LAUNCHER.md).
Self-locating from __file__: every path derives from this file's location, so there
are no hardcoded vault/home/container paths and it runs identically from cron, a
container, or any working directory.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.repo_profiles import load_repo_profiles  # noqa: E402

# This file lives at <OliverCode>/scripts/olivercode, so the repo root is two up.
# Nothing else is hardcoded.
OC_ROOT = Path(__file__).resolve().parent.parent

COMMANDS = [
    ("olivercode bootstrap DIR [--dry-run]", "Stamp the project template into a repo, per the bootstrap manifest"),
    ("olivercode discover --root DIR", "Scan for git repos and report what governance they already have"),
    ("olivercode install", "Symlink CLAUDE.md + skills into ~/.claude (backs up anything it replaces)"),
    ("olivercode init", "Create local/ fleet config from the tracked examples (never overwrites)"),
    ("olivercode health", "Run health checks: dependencies, core entrypoints, placement drift"),
    ("olivercode update", "Pull this checkout's tracking branch, then sync fleet hooks"),
    ("olivercode sync-hooks", "Converge hooks + core.hooksPath across the fleet and the vault"),
    ("olivercode skills [--grep TERM]", "List every skill in skills/, optionally filtered by name/description"),
]


def print_usage() -> None:
    print("OliverCode Terminal Launcher\n")
    print("Commands:")
    for cmd, desc in COMMANDS:
        print(f"  {cmd:<32} {desc}")


def _parse_skill_frontmatter(skill_md: Path) -> tuple[str, str]:
    """Extract (name, description) from a SKILL.md's YAML frontmatter.

    Hand-rolled rather than a PyYAML dependency: this repo's frontmatter is a
    narrow subset (flat `key: value` pairs, optional `>`/`>-` folded block
    scalars for `description`) and stays that way by convention, so a small
    parser here is less than the cost of a new dependency.
    """
    name = skill_md.parent.name
    description = ""
    try:
        lines = skill_md.read_text(encoding="utf-8", errors="ignore").splitlines()
    except OSError:
        return name, description
    if not lines or lines[0].strip() != "---":
        return name, description
    try:
        end = lines.index("---", 1)
    except ValueError:
        return name, description
    frontmatter = lines[1:end]

    i = 0
    while i < len(frontmatter):
        line = frontmatter[i]
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip().strip("\"'") or name
            i += 1
            continue
        if line.startswith("description:"):
            rest = line.split(":", 1)[1].strip()
            if rest in (">", ">-", "|", "|-"):
                folded: list[str] = []
                i += 1
                while i < len(frontmatter) and (frontmatter[i].startswith(" ") or not frontmatter[i].strip()):
                    folded.append(frontmatter[i].strip())
                    i += 1
                description = " ".join(part for part in folded if part)
                continue
            description = rest.strip("\"'")
            i += 1
            continue
        i += 1
    return name, description


def _load_skills(oc_root: Path) -> list[tuple[str, str]]:
    """Every skill in skills/: (name, description), sorted by name.

    Reads SKILL.md frontmatter directly rather than skills/INDEX.md's prose
    tables — INDEX.md is for humans browsing by category; this is the
    always-accurate source since it can't drift from the skills it describes.
    """
    skills_dir = oc_root / "skills"
    entries: list[tuple[str, str]] = []
    if not skills_dir.is_dir():
        return entries
    for skill_md in sorted(skills_dir.glob("*/SKILL.md")):
        entries.append(_parse_skill_frontmatter(skill_md))
    return sorted(entries, key=lambda pair: pair[0])


def command_skills(argv: list[str]) -> int:
    """List every skill under skills/, optionally filtered by --grep TERM."""
    term = None
    if "--grep" in argv:
        idx = argv.index("--grep")
        if idx + 1 >= len(argv):
            print("Error: --grep requires a search term.")
            return 1
        term = argv[idx + 1].lower()

    skills = _load_skills(OC_ROOT)
    if not skills:
        print("No skills found under skills/.")
        return 1

    if term:
        skills = [(n, d) for n, d in skills if term in n.lower() or term in d.lower()]
        if not skills:
            print(f"No skills match '{term}'.")
            return 0

    width = max((len(n) for n, _ in skills), default=0)
    for name, description in skills:
        summary = description if len(description) <= 100 else description[:97] + "..."
        print(f"{name:<{width}}  {summary}")
    print(f"\n{len(skills)} skill(s).")
    return 0


def _report_claude_dir(oc_root: Path) -> None:
    """Inventory ~/.claude, classifying what is OliverCode's and what is not.

    An existing setup accumulates a mix: symlinks into this checkout, symlinks into
    somewhere else entirely, real directories holding untracked content, and broken
    links pointing at things that moved. `install` only manages the first kind and
    deliberately leaves the rest alone -- which is safe, but silent. Adoption needs the
    full picture, because the foreign and real entries are exactly the ones a human has
    to make a decision about.
    """
    claude_dir = Path.home() / ".claude"
    print("\n~/.claude inventory")
    print("-" * 40)
    if not claude_dir.is_dir():
        print("  not present — `olivercode install` creates it")
        return

    rules = claude_dir / "CLAUDE.md"
    if rules.is_symlink():
        target = rules.resolve()
        owner = "OliverCode" if str(target).startswith(str(oc_root)) else f"elsewhere -> {target}"
        print(f"  CLAUDE.md   symlink ({owner})")
    elif rules.is_file():
        print("  CLAUDE.md   REAL FILE — `install` will back it up, not overwrite it")
    else:
        print("  CLAUDE.md   absent")

    skills_dir = claude_dir / "skills"
    if not skills_dir.is_dir():
        print("  skills/     absent")
        return

    ours, foreign, real, broken = [], [], [], []
    for entry in sorted(skills_dir.iterdir()):
        if entry.name.startswith("."):
            continue
        if entry.is_symlink():
            if not entry.exists():
                broken.append(entry.name)
            elif str(entry.resolve()).startswith(str(oc_root)):
                ours.append(entry.name)
            else:
                foreign.append((entry.name, entry.resolve()))
        elif entry.is_dir():
            real.append(entry.name)

    print(f"  skills/     {len(ours)} linked to this checkout, {len(foreign)} linked elsewhere, "
          f"{len(real)} real dirs, {len(broken)} broken")
    if foreign:
        print("\n  Symlinked outside this checkout — fine if deliberate (personal/business")
        print("  skills belong in your own area per docs/skills-placement.md):")
        for name, target in foreign:
            print(f"    {name} -> {target}")
    if real:
        print("\n  Real directories, untracked by any repo. `install` does NOT touch these.")
        print("  Vendor skills are the usual reason; anything else is content with no backup:")
        for name in real:
            print(f"    {name}")
    if broken:
        print("\n  BROKEN — the target moved or was deleted. `olivercode health` FAILs on these:")
        for name in broken:
            print(f"    {name}")


def command_discover(oc_root: Path, roots: list[Path]) -> int:
    """Find git repos under the given roots and report what governance they already have.

    Adoption docs assume you know where your repos are. Someone folding this into an
    existing, un-tidy setup often does not: repos spread over several directories,
    agent-rules files under three different names, hooks installed in some places and
    not others. This is the inventory step made mechanical -- read-only, and it emits
    a profile skeleton with explicit `path` values so a scattered layout is registrable
    without hand-writing JSON.
    """
    print("OliverCode discover — read-only scan")
    print("=" * 40)
    found: list[tuple[str, Path, str, str]] = []
    for root in roots:
        for git_dir in sorted(root.rglob(".git")):
            repo = git_dir.parent
            # Don't descend into vendored or nested-checkout noise.
            if any(part in {"node_modules", ".next", "vendor", "worktrees"} for part in repo.parts):
                continue
            if repo.resolve() == oc_root.resolve():
                continue  # the framework repo governs the fleet; it is not part of it
            rules = next((n for n in ("CLAUDE.md", "AGENTS.md", ".cursorrules") if (repo / n).is_file()), "none")
            hooks = subprocess.run(
                ["git", "-C", str(repo), "config", "--get", "core.hooksPath"],
                capture_output=True, text=True,
            ).stdout.strip() or "unset"
            found.append((repo.name, repo, rules, hooks))

    if not found:
        print("  No git repositories found under: " + ", ".join(str(r) for r in roots))
        return 1

    width = max(len(n) for n, _, _, _ in found)
    for name, repo, rules, hooks in found:
        flag = "" if hooks != "unset" else "   <- ungoverned: git runs no hooks here"
        print(f"  {name:<{width}}  rules={rules:<12} hooksPath={hooks}{flag}")

    print(f"\n{len(found)} repo(s). Rules files named anything other than CLAUDE.md do not")
    print("auto-load in Claude Code — merge them into CLAUDE.md (docs/ADOPTING.md Step 4).")

    _report_claude_dir(oc_root)
    print("\nProfile skeleton — paste into local/repo-profiles.json under \"profiles\",")
    print("then add each repo's token_policy (see docs/TOKEN_POLICY.md):\n")
    skeleton = {
        name: {"name": name, "path": str(repo), "canonicalValidationCommand": "<command>"}
        for name, repo, _, _ in found
    }
    print(json.dumps(skeleton, indent=2))
    return 0


def command_bootstrap(oc_root: Path, target: Path, dry_run: bool) -> int:
    """Stamp the project template into a repo, per shared/project-bootstrap-manifest.json.

    The manifest declared 27 templated files and 5 required directories and NOTHING read
    it -- `sync-hooks` covered the two hook files and every other file was a hand-copy.
    README claimed a new repo "starts compliant on day one"; this is what makes that true.

    Honours the manifest's modes: `strict` files are overwritten (their contract is
    byte-identity with the template), `presence` files are only created when missing so
    repo-specific content is never clobbered. `conditionalFiles` are reported, not copied
    -- they depend on profile flags the target repo may not set.
    """
    manifest_path = oc_root / "shared" / "project-bootstrap-manifest.json"
    if not manifest_path.is_file():
        print(f"  [FAIL] manifest not found: {manifest_path}")
        return 1
    manifest = json.loads(manifest_path.read_text())

    if not (target / ".git").exists():
        print(f"  [FAIL] {target} is not a git repository.")
        print("         Run `git init` there first — the hooks need a real .git.")
        return 1

    label = "DRY RUN — nothing written" if dry_run else f"stamping into {target}"
    print(f"OliverCode bootstrap — {label}")
    print("=" * 40)

    made_dirs = []
    for rel in manifest.get("requiredDirectories", []):
        d = target / rel
        if not d.is_dir():
            made_dirs.append(rel)
            if not dry_run:
                d.mkdir(parents=True, exist_ok=True)
    if made_dirs:
        print(f"  directories: {', '.join(made_dirs)}")

    new = overwritten = kept = 0
    missing_src = []
    for entry in manifest.get("templatedFiles", []):
        src, dst_rel, mode = oc_root / entry["source"], entry["target"], entry.get("mode", "presence")
        dst = target / dst_rel
        if not src.is_file():
            missing_src.append(entry["source"])
            continue
        exists = dst.exists()
        if exists and mode == "presence":
            kept += 1
            continue
        action = "OVERWRITE" if exists else "NEW"
        if exists:
            overwritten += 1
        else:
            new += 1
        print(f"  [{action:<9}] {dst_rel}" + (f"   ({mode})" if exists else ""))
        if not dry_run:
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_bytes(src.read_bytes())
            if src.suffix == ".sh" or dst_rel.startswith(".githooks/"):
                dst.chmod(0o755)

    print(f"\n  {new} new, {overwritten} overwritten (strict), {kept} kept (presence, already present)")
    for rel in missing_src:
        print(f"  [FAIL] template source missing from this checkout: {rel}")

    conditional = manifest.get("conditionalFiles", [])
    if conditional:
        print("\n  Not copied — these depend on profile flags (see docs/KEEPALIVE_STANDARD.md):")
        for entry in conditional:
            print(f"    {entry['source']}  when {entry.get('condition', '?')}")

    if dry_run:
        print("\nRe-run without --dry-run to apply.")
    else:
        print("\nNext: `olivercode sync-hooks` installs the hooks and sets core.hooksPath,")
        print("then fill in the placeholders in docs/repo-structure-contract.md.")
    return 1 if missing_src else 0


def command_install(oc_root: Path) -> int:
    """Activate this checkout: symlink CLAUDE.md and every skill into ~/.claude.

    This is the step that makes the rules load in every session from any directory.
    Doing it by hand is four commands and fails silently in two ways -- `ln` into a
    missing ~/.claude/skills dies with a bare "No such file or directory", and
    replacing an existing real CLAUDE.md destroys rules the operator may not have
    copied anywhere yet.

    Never destructive: a real file (not a symlink) at a target path is moved aside to
    `<name>.pre-olivercode` and the path is reported, because that file is usually the
    operator's entire accumulated ruleset and docs/ADOPTING.md Step 3 exists to merge
    it back in deliberately.
    """
    claude_dir = Path.home() / ".claude"
    skills_dir = claude_dir / "skills"
    print("OliverCode install — activating this checkout in ~/.claude")
    print("=" * 40)

    # A plain file sitting where a directory belongs is rare but real, and an unhandled
    # FileExistsError traceback is a poor first impression from the first command a fork
    # runs. Say what is wrong and what to do about it.
    for needed in (claude_dir, skills_dir):
        if needed.exists() and not needed.is_dir():
            print(f"  [FAIL] {needed} exists but is not a directory.")
            print("         Move or remove it, then re-run `olivercode install`.")
            return 1
    skills_dir.mkdir(parents=True, exist_ok=True)
    backups: list[str] = []

    def _link(target: Path, source: Path) -> str:
        """Point target at source. Returns a one-word status."""
        if target.is_symlink():
            if target.resolve() == source.resolve():
                return "already"
            target.unlink()
            return _link(target, source)
        if target.exists():
            backup = target.with_name(target.name + ".pre-olivercode")
            if backup.exists():
                backup = target.with_name(target.name + ".pre-olivercode.bak")
            target.rename(backup)
            backups.append(str(backup))
            target.symlink_to(source)
            return "backed-up"
        target.symlink_to(source)
        return "linked"

    status = _link(claude_dir / "CLAUDE.md", oc_root / "CLAUDE.md")
    print(f"  [{status.upper()}] ~/.claude/CLAUDE.md")

    linked = already = 0
    for skill in sorted(p for p in (oc_root / "skills").iterdir() if (p / "SKILL.md").is_file()):
        result = _link(skills_dir / skill.name, skill)
        if result == "already":
            already += 1
        else:
            linked += 1
    print(f"  [OK] skills: {linked} linked, {already} already correct")

    broken = sorted(p.name for p in skills_dir.iterdir() if p.is_symlink() and not p.exists())
    if broken:
        print(f"  [FAIL] broken symlinks in ~/.claude/skills/: {', '.join(broken)}")

    untouched = sorted(
        p.name for p in skills_dir.iterdir()
        if p.name and not p.name.startswith(".")
        and not (p.is_symlink() and p.exists() and str(p.resolve()).startswith(str(oc_root)))
    )
    if untouched:
        print(f"  [KEPT] {len(untouched)} entr(y/ies) not managed by this checkout, left as-is: "
              f"{', '.join(untouched)}")
        print("         `olivercode discover --root <dir>` classifies them.")

    print()
    if backups:
        print("Backed up, NOT deleted — merge these in deliberately, they are usually")
        print("the rules you already had (docs/ADOPTING.md Step 3):")
        for b in backups:
            print(f"  {b}")
        print()
    print("Next: `olivercode init` to seed local/, then `olivercode health` to verify.")
    return 1 if broken else 0


# local/ overlay files, each seeded from a tracked placeholder. Adding a pair here is
# all it takes to make a new registry part of `init`.
LOCAL_SEEDS = (
    ("shared/repo-profiles.example.json", "local/repo-profiles.json"),
    ("shared/repo-map.json", "local/repo-map.json"),
    ("shared/project-structure-rules.json", "local/project-structure-rules.json"),
)


def command_init(oc_root: Path) -> int:
    """Seed the gitignored local/ overlay from the tracked example registries.

    Non-destructive and idempotent by contract: an existing local/ file is never
    overwritten, because it holds the operator's real fleet and this command is the
    one a confused user is most likely to re-run.
    """
    print("OliverCode init — seeding local/ from tracked examples")
    print("=" * 40)
    created, kept, missing = [], [], []

    for src_rel, dst_rel in LOCAL_SEEDS:
        src, dst = oc_root / src_rel, oc_root / dst_rel
        if not src.exists():
            missing.append(src_rel)
            continue
        if dst.exists():
            kept.append(dst_rel)
            continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_bytes(src.read_bytes())
        created.append(dst_rel)

    for rel in created:
        print(f"  [NEW]  {rel}")
    for rel in kept:
        print(f"  [KEPT] {rel} — already exists, left untouched")
    for rel in missing:
        print(f"  [FAIL] {rel} — example missing from this checkout")

    print()
    if created:
        print("Next: edit the files above with your real repo names, validation commands,")
        print("and token policy, then run `olivercode sync-hooks` to install enforcement.")
        print("local/ is gitignored — real names never reach the tracked fork.")
    elif not missing:
        print("Nothing to do: local/ is already seeded.")
    print("See docs/ADOPTING.md for the full onboarding path.")
    return 1 if missing else 0


class _HealthTally:
    """Accumulates health-check results. WARN counts as passed on purpose:
    a standalone clone missing local-only context (control plane, vault) must
    still report HEALTHY (see docs/FRAMEWORK_BOUNDARY.md)."""

    def __init__(self) -> None:
        self.passed = 0
        self.failed = 0

    def ok(self, msg: str) -> None:
        print(f"  [OK] {msg}")
        self.passed += 1

    def warn(self, msg: str) -> None:
        print(f"  [WARN] {msg}")
        self.passed += 1

    def fail(self, msg: str) -> None:
        print(f"  [FAIL] {msg}")
        self.failed += 1

    def add(self, passed: int, failed: int) -> None:
        self.passed += passed
        self.failed += failed


def command_health(fleet_root: Path | None = None) -> int:
    """Run health checks: dependency doc, core entrypoints, placement drift."""
    print("OliverCode Health Check")
    print("=" * 40)
    t = _HealthTally()

    # 1. Dependency doc + the OliverCode-relative paths it declares.
    # OLIVERCODE_DEPENDENCY.md lists paths as backtick-quoted, repo-relative entries
    # (e.g. `shared/repo-map.json`, `core/contracts/`). Parse them in-process and resolve
    # the OliverCode-relative ones under OC_ROOT — skip vault paths like `Oliver/`.
    print("\nDependency paths:")
    dep_file = OC_ROOT / "runtime" / "control-plane" / "OLIVERCODE_DEPENDENCY.md"
    if not dep_file.exists():
        t.warn("control plane not installed — skipping dependency-path check")
    else:
        oc_dirs = ("shared/", "core/", "docs/", "scripts/", "tooling/", "runtime/", ".githooks/")
        text = dep_file.read_text(encoding="utf-8", errors="ignore")
        declared = [m for m in re.findall(r"`([^`]+)`", text) if m.startswith(oc_dirs)]
        missing = [rel for rel in declared if not (OC_ROOT / rel).exists()]
        if not declared:
            t.warn("no OliverCode-relative dependency paths declared")
        elif not missing:
            t.ok(f"all {len(declared)} declared dependency paths resolve")
        else:
            for rel in missing:
                t.fail(f"{rel} — not found")

    # 2. Core entrypoints
    print("\nCore entrypoints:")
    checks = [
        ("scripts/olivercode (CLI)", OC_ROOT / "scripts" / "olivercode"),
        ("docs/FRAMEWORK_BOUNDARY.md", OC_ROOT / "docs" / "FRAMEWORK_BOUNDARY.md"),
    ]
    for name, fpath in checks:
        t.ok(name) if fpath.exists() else t.fail(f"{name} — missing")

    # The control-plane launcher is gitignored local state — required only when
    # the control plane is installed at all (standalone clones must stay HEALTHY,
    # same rule as the dependency-doc check above).
    if (OC_ROOT / "runtime" / "control-plane").exists():
        if (OC_ROOT / "runtime" / "control-plane" / "olivercode").exists():
            t.ok("runtime/control-plane/olivercode (launcher)")
        else:
            t.fail("runtime/control-plane/olivercode — control plane present but launcher missing")
    else:
        t.warn("control plane not installed — skipping launcher check")

    # 3. Placement drift (SYS-2, spec: docs/skills-placement.md "Drift check").
    # Everything here reads OUTSIDE OC_ROOT (the vault, sibling fleet repos), so it
    # must degrade to WARN, never FAIL, when that context isn't present — a standalone
    # clone with no surrounding vault is still a valid, healthy checkout.
    t.add(*_check_placement_drift(OC_ROOT, fleet_root))

    # Summary
    total = t.passed + t.failed
    print(f"\n{'=' * 40}")
    if t.failed == 0:
        print(f"HEALTHY — {t.passed}/{total} checks passed")
    else:
        print(f"DEGRADED — {t.passed}/{total} passed, {t.failed} failed")
    return 1 if t.failed else 0


def _resolve_repo_path(name: str, profile: dict, fleet_root: Path) -> Path:
    """Where a fleet repo actually lives.

    Default is the sibling convention `<fleet_root>/<name>`, which assumes every repo
    sits under one parent. That assumption breaks the moment someone adopts this into
    an existing setup whose repos are spread across several directories -- and before
    this existed, such a repo could not be registered at all, because the name WAS the
    path. An optional `path` in the profile takes precedence: absolute, `~`-relative,
    or relative to fleet_root.
    """
    declared = profile.get("path")
    if not declared:
        return fleet_root / name
    p = Path(declared).expanduser()
    return p if p.is_absolute() else (fleet_root / p)


def _hook_problems(hooks_dir: Path, templates_dir: Path) -> list[str]:
    """Return human-readable problems with a repo's live hook directory.

    Checks, in the order they can silently disable enforcement:

    1. The directory core.hooksPath points at does not exist. Git treats this as
       "no hooks" and runs NOTHING, without warning — a commit with secrets in it
       sails straight through. This is the failure this function exists to catch:
       an earlier version returned "no divergence" for a missing directory, which
       the caller reported as [OK].
    2. No `pre-commit` file in it. Same silent no-op; git only auto-invokes that
       exact filename.
    3. Present but not executable. Git skips a non-executable hook silently too.
    4. Present, executable, but content matches neither canonical template.

    A repo running the private (2-gate) variant still deploys it under the filename
    `pre-commit`, so a live `pre-commit` is checked against BOTH template contents.
    """
    if not hooks_dir.is_dir():
        return [f"core.hooksPath points at {hooks_dir}, which does not exist — git runs NO hooks"]

    live = hooks_dir / "pre-commit"
    if not live.is_file():
        return [f"no pre-commit file in {hooks_dir} — git runs NO hooks"]
    if not os.access(live, os.X_OK):
        return [f"{live} is not executable — git skips it silently"]

    canonical_contents = []
    for template in ("pre-commit", "pre-commit-private"):
        canonical = templates_dir / template
        if canonical.exists():
            canonical_contents.append(canonical.read_bytes())

    problems = []
    for filename in ("pre-commit", "pre-commit-private"):
        candidate = hooks_dir / filename
        if not candidate.exists():
            continue
        if candidate.read_bytes() not in canonical_contents:
            problems.append(f"{filename} diverges from the template")
    return problems


def _check_placement_drift(oc_root: Path, fleet_root: Path | None = None) -> tuple[int, int]:
    print("\nPlacement drift (skills-placement.md):")
    passed = 0
    failed = 0
    templates_dir = oc_root / "core" / "templates" / "project"

    # Vault root: OLIVERCODE_VAULT_ROOT env var wins; otherwise the layout
    # convention <vault>/<...>/<...>/OliverCode == oc_root (three levels up).
    # Forks living elsewhere set the env var or just get WARN-skips (safe).
    import os as _os
    _env_vault = _os.environ.get("OLIVERCODE_VAULT_ROOT")
    vault_root = Path(_env_vault) if _env_vault else oc_root.parent.parent.parent

    # (a)/(b) Every OliverCode skill must have a live, correctly-targeted symlink at
    # ~/.claude/skills/<name> -- that's the mechanism making it invocable from any repo.
    # ~/.claude/skills/ is a real directory (not one whole-directory symlink) holding a
    # mix of individual symlinks (orchestration + personal) and real, untracked product/
    # GTM and vendor content -- only the symlinked half is checkable from here.
    claude_skills_dir = Path.home() / ".claude" / "skills"
    if not claude_skills_dir.is_dir():
        print("  [WARN] ~/.claude/skills/ not present — skipping")
        passed += 1
    else:
        skills_dir = oc_root / "skills"
        oc_skill_names = sorted(
            p.name for p in skills_dir.iterdir() if p.is_dir() and (p / "SKILL.md").exists()
        ) if skills_dir.is_dir() else []
        installed, missing, wrong_target = [], [], []
        for name in oc_skill_names:
            link = claude_skills_dir / name
            expected = skills_dir / name
            if not link.is_symlink():
                missing.append(name)
            elif link.resolve() != expected.resolve():
                wrong_target.append(name)
            else:
                installed.append(name)
        if oc_skill_names and not installed:
            # Zero symlinks resolve into THIS checkout: it isn't the machine's installed
            # OliverCode (fresh clone, fork, or scratch copy). That's a valid state, not
            # drift -- G4 requires a stranger clone to report HEALTHY.
            print(f"  [WARN] this checkout is not the machine's installed OliverCode "
                  f"(no ~/.claude/skills/ symlinks point here) — to install, see docs/skills-placement.md")
            passed += 1
        elif missing:
            print(f"  [FAIL] not symlinked at ~/.claude/skills/: {', '.join(missing)}")
            failed += 1
        elif wrong_target:
            print(f"  [FAIL] symlinked but pointing elsewhere: {', '.join(wrong_target)}")
            failed += 1
        else:
            print(f"  [OK] all {len(oc_skill_names)} OliverCode skills correctly symlinked at ~/.claude/skills/")
            passed += 1

        broken = sorted(
            p.name for p in claude_skills_dir.iterdir() if p.is_symlink() and not p.exists()
        )
        if broken:
            print(f"  [FAIL] broken symlinks in ~/.claude/skills/: {', '.join(broken)}")
            failed += 1
        else:
            passed += 1

    # (c) Fleet repos: unset core.hooksPath, or a hook file diverging from the template.
    profiles, _ = load_repo_profiles(oc_root)
    fleet_names = [name for name in profiles if name != "olivercode"]
    if not fleet_names:
        print("  [WARN] no fleet registered in local/repo-profiles.json — skipping hook-drift check")
        passed += 1
    else:
        for name in fleet_names:
            repo_path = _resolve_repo_path(name, profiles[name], fleet_root or oc_root.parent)
            if not (repo_path / ".git").exists():
                print(f"  [WARN] {name}: not present on this machine — skipping")
                passed += 1
                continue
            result = subprocess.run(
                ["git", "-C", str(repo_path), "config", "--get", "core.hooksPath"],
                capture_output=True, text=True,
            )
            hooks_path = result.stdout.strip()
            if result.returncode != 0 or not hooks_path:
                print(f"  [FAIL] {name}: core.hooksPath unset")
                failed += 1
                continue
            hooks_dir = repo_path / hooks_path
            problems = _hook_problems(hooks_dir, templates_dir)
            variant = profiles[name].get("hookVariant")
            if problems and variant:
                # A repo may legitimately need a hook the template cannot express (a
                # repo-specific governance path, a gate whose checker only exists there).
                # Declaring `hookVariant` in the profile says "this divergence is
                # considered" -- it is reported, not failed, and sync-hooks leaves it
                # alone. Divergence WITHOUT a declaration is still a failure, so this
                # cannot be used to quietly opt out of enforcement.
                fatal = [p for p in problems if "diverges" not in p]
                if fatal:
                    print(f"  [FAIL] {name}: {'; '.join(fatal)}")
                    failed += 1
                else:
                    print(f"  [WARN] {name}: declared hook variant ({variant}) — "
                          f"{'; '.join(problems)}")
                    passed += 1
            elif problems:
                print(f"  [FAIL] {name}: {'; '.join(problems)}")
                failed += 1
            else:
                print(f"  [OK] {name}: hooksPath set, hooks match template")
                passed += 1

    # The vault itself is a managed hook target too (SYS-3), same private-variant check.
    if not (vault_root / ".git").exists():
        print("  [WARN] no vault .git found — skipping vault hook check")
        passed += 1
    else:
        result = subprocess.run(
            ["git", "-C", str(vault_root), "config", "--get", "core.hooksPath"],
            capture_output=True, text=True,
        )
        hooks_path = result.stdout.strip()
        if result.returncode != 0 or not hooks_path:
            print("  [FAIL] vault: core.hooksPath unset")
            failed += 1
        else:
            problems = _hook_problems(vault_root / hooks_path, templates_dir)
            if problems:
                print(f"  [FAIL] vault: {'; '.join(problems)}")
                failed += 1
            else:
                print("  [OK] vault: hooksPath set, hooks match template")
                passed += 1

    return passed, failed


def _install_hook_pair(repo_path: Path, templates_dir: Path, private_repo: bool) -> None:
    """Idempotently deploy the hook template(s) + hooksPath config to one repo.

    Public repos get the 7-gate public template as the live `pre-commit` file
    (plus the private variant alongside as a reference copy, matching the
    existing manifest convention). The vault (private_repo=True) gets the
    private 2-gate template's content deployed AS `pre-commit` — git only
    auto-invokes that exact filename, there's no such thing as a repo
    literally running a file named `pre-commit-private`.
    """
    hooks_dir = repo_path / ".githooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)

    live_source = templates_dir / ("pre-commit-private" if private_repo else "pre-commit")
    live_target = hooks_dir / "pre-commit"
    live_target.write_bytes(live_source.read_bytes())
    live_target.chmod(0o755)

    if not private_repo:
        reference_source = templates_dir / "pre-commit-private"
        reference_target = hooks_dir / "pre-commit-private"
        reference_target.write_bytes(reference_source.read_bytes())
        reference_target.chmod(0o755)

    subprocess.run(["git", "-C", str(repo_path), "config", "core.hooksPath", ".githooks"], check=True)


def command_sync_hooks(oc_root: Path, fleet_root: Path | None = None) -> int:
    """SYS-3: converge hooks + core.hooksPath across every fleet repo and the vault.

    fleet_root defaults to OliverCode's parent (the sibling-repos layout). A fork whose
    repos live elsewhere passes --root; without that, every repo would silently SKIP as
    "not present on this machine" and the command would still report success.
    """
    templates_dir = oc_root / "core" / "templates" / "project"
    fleet_root = fleet_root or oc_root.parent
    vault_root = oc_root.parent.parent.parent
    updated = 0
    skipped = 0

    profiles, _ = load_repo_profiles(oc_root)
    for name in profiles:
        if name.lower() == "olivercode":
            continue
        repo_path = _resolve_repo_path(name, profiles[name], fleet_root)
        if not (repo_path / ".git").exists():
            print(f"  [SKIP] {name}: not present on this machine")
            skipped += 1
            continue
        variant = profiles[name].get("hookVariant")
        if variant:
            # Declared variant: overwriting would destroy a considered customization.
            # `health` reports it as WARN rather than drift. Remove the profile field
            # to bring the repo back under the template.
            print(f"  [SKIP] {name}: declared hook variant ({variant}) — left untouched")
            skipped += 1
            continue
        _install_hook_pair(repo_path, templates_dir, private_repo=False)
        print(f"  [OK] {name}: hooks synced, hooksPath set")
        updated += 1

    if (vault_root / ".git").exists():
        _install_hook_pair(vault_root, templates_dir, private_repo=True)
        print("  [OK] vault: private-variant hook synced, hooksPath set")
        updated += 1
    else:
        print("  [SKIP] vault: no .git found at the expected location")
        skipped += 1

    print(f"\n{updated} target(s) synced, {skipped} skipped.")
    return 0


def command_update() -> int:
    """Pull this checkout's tracking branch, then converge fleet hooks.

    On a fork `origin` is the FORK, so this does not fetch upstream framework changes.
    Pulling those is a deliberate act with real merge consequences -- a fork carries local
    edits to CLAUDE.md, contracts, and templates, which is the whole point of forking -- so
    it is documented in docs/ADOPTING.md ("Staying current") rather than automated here.
    """
    pull_code = subprocess.run(["git", "-C", str(OC_ROOT), "pull"]).returncode
    if pull_code != 0:
        return pull_code
    print("\nSyncing hooks across the fleet + vault (SYS-3):")
    return command_sync_hooks(OC_ROOT)


def _take_root_flag(argv: list[str]) -> tuple[Path | None, list[str]]:
    """Pull `--root <dir>` out of argv. Returns (root or None, remaining args)."""
    if "--root" not in argv:
        return None, argv
    idx = argv.index("--root")
    if idx + 1 >= len(argv):
        print("Error: --root requires a directory.")
        sys.exit(1)
    root = Path(argv[idx + 1]).expanduser()
    if not root.is_dir():
        print(f"Error: --root {root} is not a directory.")
        sys.exit(1)
    return root, argv[:idx] + argv[idx + 2:]


def _reject_extra(cmd: str, rest: list[str]) -> None:
    """Unknown arguments must fail loudly.

    Silently ignoring them is worse than rejecting them: `sync-hooks --root /somewhere`
    used to ignore the flag, sync the DEFAULT fleet, and print "6 targets synced" -- so a
    fork with a different layout got a success message for work done on the wrong repos.
    """
    if rest:
        print(f"Error: unexpected argument(s) for '{cmd}': {' '.join(rest)}")
        print_usage()
        sys.exit(1)


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in {"--help", "-h", "help"}:
        print_usage()
        return 0

    cmd = sys.argv[1]
    argv = sys.argv[2:]

    if cmd == "discover":
        roots: list[Path] = []
        rest = argv
        while "--root" in rest:
            root, rest = _take_root_flag(rest)
            roots.append(root)
        _reject_extra(cmd, rest)
        if not roots:
            print("Error: discover requires at least one --root DIR.")
            return 1
        return command_discover(OC_ROOT, roots)
    if cmd == "bootstrap":
        dry = "--dry-run" in argv
        rest = [a for a in argv if a != "--dry-run"]
        if len(rest) != 1:
            print("Usage: olivercode bootstrap <repo-path> [--dry-run]")
            return 1
        target = Path(rest[0]).expanduser()
        if not target.is_dir():
            print(f"Error: {target} is not a directory.")
            return 1
        return command_bootstrap(OC_ROOT, target, dry)
    if cmd == "install":
        _reject_extra(cmd, argv)
        return command_install(OC_ROOT)
    if cmd == "init":
        _reject_extra(cmd, argv)
        return command_init(OC_ROOT)
    if cmd == "health":
        root, rest = _take_root_flag(argv)
        _reject_extra(cmd, rest)
        return command_health(root)
    if cmd == "update":
        _reject_extra(cmd, argv)
        return command_update()
    if cmd == "sync-hooks":
        root, rest = _take_root_flag(argv)
        _reject_extra(cmd, rest)
        return command_sync_hooks(OC_ROOT, root)
    if cmd == "skills":
        return command_skills(argv)

    print(f"Error: '{cmd}' is not a valid command.")
    print_usage()
    return 1


if __name__ == "__main__":
    sys.exit(main())
