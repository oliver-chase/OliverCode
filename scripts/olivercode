#!/usr/bin/env python3
"""OliverCode terminal launcher.

The Python CLI behind `olivercode <command>` (see docs/SETUP.md, "Launcher commands").
Self-locating from __file__: every path derives from this file's location, so there
are no hardcoded vault/home/container paths and it runs identically from cron, a
container, or any working directory.

This file parses arguments and calls one function per command. The command bodies live in
scripts/lib/cmd_*.py, and the shared argument helpers in scripts/lib/cli.py.
"""
from __future__ import annotations

import subprocess  # noqa: F401  (tests patch launcher.subprocess)
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.cli import print_usage, reject_extra as _reject_extra, require_dir as _require_dir, take_flag as _take_flag, take_root_flag as _take_root_flag  # noqa: E402
from lib.cmd_fleet import (  # noqa: E402
    command_audit_fleet, command_backlog_setup, command_conform, command_sync_hooks, command_update,
)
from lib.cmd_guide import command_guide  # noqa: E402
from lib.cmd_harness import command_job  # noqa: E402
from lib.maintain import command_maintain  # noqa: E402
from lib.evals import command_eval  # noqa: E402
from lib.failure_log import command_learn, command_report  # noqa: E402
from lib.cmd_health import command_health, _check_placement_drift  # noqa: E402,F401
from lib.cmd_install import command_install, command_uninstall, _read_record, _write_record, INSTALL_RECORD  # noqa: E402,F401
from lib.cmd_repo import (
    command_bootstrap, command_checkpoint, command_clean, command_context, command_discover, command_gh_limit, command_place,
    command_policy,
    command_restore, command_size, command_skills,
)  # noqa: E402
from lib.local_config import OC_ROOT  # noqa: E402,F401



def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in {"--help", "-h", "help"}:
        print_usage()
        return 0

    cmd = sys.argv[1]
    argv = sys.argv[2:]

    if cmd == "discover":
        roots: list[Path] = []
        rest = argv
        while "--root" in rest:
            root, rest = _take_root_flag(rest)
            roots.append(root)
        _reject_extra(cmd, rest)
        if not roots:
            print("Error: discover requires at least one --root DIR.")
            return 1
        return command_discover(OC_ROOT, roots)
    if cmd == "bootstrap":
        dry, rest = _take_flag(argv, "--dry-run")
        if len(rest) != 1:
            print("Usage: olivercode bootstrap <repo-path> [--dry-run]")
            return 1
        target = Path(rest[0]).expanduser()
        return command_bootstrap(OC_ROOT, target, dry) if _require_dir(target) else 1
    if cmd == "size":
        lower, rest = _take_flag(argv, "--lower")
        if len(rest) > 1:
            _reject_extra(cmd, rest[1:])
        target = Path(rest[0]).expanduser() if rest else Path.cwd()
        return command_size(OC_ROOT, target, lower) if _require_dir(target) else 1
    if cmd == "backlog-setup":
        return command_backlog_setup(argv)
    if cmd == "install":
        _reject_extra(cmd, argv)
        return command_install(OC_ROOT)
    if cmd == "uninstall":
        _reject_extra(cmd, argv)
        return command_uninstall(OC_ROOT)

    if cmd == "health":
        root, rest = _take_root_flag(argv)
        _reject_extra(cmd, rest)
        return command_health(root)
    if cmd == "gh-limit":
        return command_gh_limit(argv)
    if cmd == "policy":
        return command_policy(argv)
    if cmd in ("checkpoint", "restore", "context"):
        if len(argv) > 1:
            _reject_extra(cmd, argv[1:])
        target = Path(argv[0]).expanduser() if argv else Path.cwd()
        run = {"checkpoint": command_checkpoint, "restore": command_restore, "context": command_context}[cmd]
        return run(target) if _require_dir(target) else 1
    if cmd == "place":
        _reject_extra(cmd, argv)
        return command_place()
    if cmd == "clean":
        apply, rest = _take_flag(argv, "--apply")
        _reject_extra(cmd, rest)
        return command_clean(apply)
    if cmd == "conform":
        offline, rest = _take_flag(argv, "--offline")
        root, rest = _take_root_flag(rest)
        if len(rest) > 1:
            _reject_extra(cmd, rest[1:])
        return command_conform(OC_ROOT, Path(rest[0]).resolve() if rest else None, root, offline)
    if cmd == "update":
        _reject_extra(cmd, argv)
        return command_update()
    if cmd == "sync-hooks":
        root, rest = _take_root_flag(argv)
        _reject_extra(cmd, rest)
        return command_sync_hooks(OC_ROOT, root)
    if cmd == "audit-fleet":
        _reject_extra(cmd, argv)
        return command_audit_fleet(OC_ROOT)
    if cmd == "skills":
        return command_skills(argv)
    if cmd == "maintain":
        return command_maintain(argv)
    if cmd == "learn":
        return command_learn(argv)
    if cmd == "report":
        return command_report(argv)
    if cmd == "eval":
        return command_eval(argv)
    if cmd == "job":
        return command_job(argv)
    if cmd == "guide":
        _reject_extra(cmd, argv)
        return command_guide(OC_ROOT)

    print(f"Error: '{cmd}' is not a valid command.")
    print_usage()
    return 1


if __name__ == "__main__":
    sys.exit(main())
