{"guard": "placement_guard", "scenarios": [
    {"name": "A worktree outside the worktrees folder is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git worktree add /tmp/elsewhere-wt -b story/1"}, "cwd": "{repo}"}, "expect": "deny", "reason": "Worktrees live under"},
    {"name": "A clone outside the repo root is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git clone https://github.com/example/thing.git /tmp/elsewhere-thing"}, "cwd": "{repo}"}, "expect": "deny", "reason": "Repos live under"},
    {"name": "A clone into the current folder outside the root is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git clone https://github.com/example/thing.git"}, "cwd": "{tmp}"}, "expect": "deny", "reason": "Repos live under"},
    {"name": "A worktree inside the worktrees folder is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "git worktree add {root}/_worktrees/oc-1 -b story/1"}, "cwd": "{repo}"}, "expect": "allow"},
    {"name": "A clone inside the repo root is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "git clone https://github.com/example/thing.git {root}/thing"}, "cwd": "{repo}"}, "expect": "allow"},
    {"name": "A GitHub repo created for a folder with no origin is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "gh repo create --private --source=. --push"}, "cwd": "{repo}"}, "expect": "deny", "reason": "report the folder to the owner"},
    {"name": "A worktree listing is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "git worktree list"}, "cwd": "{repo}"}, "expect": "allow"},
    {"name": "A command that only names clone is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo git clone is the verb"}, "cwd": "{repo}"}, "expect": "allow"}
]}
