    {"name": "A recursive delete asks the owner", "payload": {"tool_name": "Bash", "tool_input": {"command": "rm -rf build"}, "cwd": "{repo}"}, "expect": "ask", "reason": "asks first", "policy": {"version": 1, "commands": {"allow": [], "deny": ["(curl|wget)\\s+.*\\|\\s*(ba|z)?sh"]}, "paths": {"allow": ["**"], "deny": [".env", ".githooks/**"]}, "triggers": {"gateFailures": 3, "deleteFiles": 10, "push": true}}},
    {"name": "An ordinary command is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "ls -la"}, "cwd": "{repo}"}, "expect": "allow", "policy": {"version": 1, "commands": {"allow": [], "deny": ["(curl|wget)\\s+.*\\|\\s*(ba|z)?sh"]}, "paths": {"allow": ["**"], "deny": [".env", ".githooks/**"]}, "triggers": {"gateFailures": 3, "deleteFiles": 10, "push": true}}},
