{"guard": "commit_guard", "scenarios": [
    {"name": "A commit with --no-verify is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit --no-verify -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "deny", "reason": "--no-verify"},
    {"name": "A commit with -n is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -n -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "deny", "reason": "--no-verify"},
    {"name": "A commit with -an is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -an -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "deny", "reason": "--no-verify"},
    {"name": "A commit wrapped in bash -c is read as a command line", "payload": {"tool_name": "Bash", "tool_input": {"command": "bash -c 'git commit --no-verify -m x'"}, "cwd": "{repo}"}, "expect": "deny", "reason": "--no-verify"},
    {"name": "A commit that overrides core.hooksPath is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git -c core.hooksPath=/dev/null commit -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "deny", "reason": "core.hooksPath"},
    {"name": "A commit in a repo where git runs no gates is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "deny", "reason": "core.hooksPath is unset", "repo": "unhooked"},
    {"name": "A plain commit in a gated repo is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "allow"},
    {"name": "A message that names --no-verify as text is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m \"Never pass --no-verify (#1)\""}, "cwd": "{repo}"}, "expect": "allow"},
    {"name": "A commit in a repo with no gates is allowed with any flag", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit --no-verify -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "allow", "repo": "plain"}
]}
