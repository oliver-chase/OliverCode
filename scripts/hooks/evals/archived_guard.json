{"guard": "archived_guard", "scenarios": [
    {"name": "A commit in an archived repo is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "deny", "reason": "archived on GitHub", "home_files": {"repo-state.json": {"example/thing": {"state": "archived", "at": "@now"}}}, "origin": "https://github.com/example/thing.git", "env": {"OLIVERCODE_ARCHIVED": "on"}},
    {"name": "A push in an archived repo is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git push origin main"}, "cwd": "{repo}"}, "expect": "deny", "reason": "archived on GitHub", "home_files": {"repo-state.json": {"example/thing": {"state": "archived", "at": "@now"}}}, "origin": "https://github.com/example/thing.git", "env": {"OLIVERCODE_ARCHIVED": "on"}},
    {"name": "A commit aimed at an archived repo with git -C is denied", "payload": {"tool_name": "Bash", "tool_input": {"command": "git -C {repo} commit -m \"Fix it (#1)\""}, "cwd": "{tmp}"}, "expect": "deny", "reason": "archived on GitHub", "home_files": {"repo-state.json": {"example/thing": {"state": "archived", "at": "@now"}}}, "origin": "https://github.com/example/thing.git", "env": {"OLIVERCODE_ARCHIVED": "on"}},
    {"name": "A commit in an active repo is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "allow", "home_files": {"repo-state.json": {"example/thing": {"state": "active", "at": "@now"}}}, "origin": "https://github.com/example/thing.git", "env": {"OLIVERCODE_ARCHIVED": "on"}},
    {"name": "A read in an archived repo is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "git status"}, "cwd": "{repo}"}, "expect": "allow", "home_files": {"repo-state.json": {"example/thing": {"state": "archived", "at": "@now"}}}, "origin": "https://github.com/example/thing.git", "env": {"OLIVERCODE_ARCHIVED": "on"}},
    {"name": "A commit in a repo with no GitHub origin is allowed", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "allow", "env": {"OLIVERCODE_ARCHIVED": "on"}},
    {"name": "The check is off when OLIVERCODE_ARCHIVED is off", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m \"Fix it (#1)\""}, "cwd": "{repo}"}, "expect": "allow", "home_files": {"repo-state.json": {"example/thing": {"state": "archived", "at": "@now"}}}, "origin": "https://github.com/example/thing.git"}
]}
