# OliverCode Environment Variables

# Required: Vault Root (for vault mode only)
# OLIVERCODE_VAULT_ROOT="/path/to/your/vault"

# Required: OliverCode Root (auto-detected if not set)
# OLIVERCODE_ROOT="/path/to/OliverCode"

# Provider API Keys (optional - use OAuth where available)
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="..."
# NVIDIA_API_KEY="nvapi-..."
# DEEPSEEK_API_KEY="..."

# Provider Configuration
# OLLAMA_HOST="http://localhost:11434"

# Console Configuration (for local web console)
# OLIVERCODE_CONSOLE_PORT="3000"
# OLIVERCODE_CONSOLE_HOST="127.0.0.1"

# Debug Mode (for development)
# OLIVERCODE_DEBUG="false"
