{
  "_comment": "This repo's permission policy: the commands and paths an agent may use, and the actions that ask the owner first.",
  "version": 1,
  "commands": {
    "allow": [],
    "deny": [
      "curl\\s+.*\\|\\s*(ba|z)?sh"
    ]
  },
  "paths": {
    "allow": [
      "**"
    ],
    "deny": [
      ".git/**",
      ".env",
      ".env.*",
      ".secrets/**",
      ".githooks/**"
    ]
  },
  "triggers": {
    "gateFailures": 3,
    "deleteFiles": 10,
    "push": true
  }
}
