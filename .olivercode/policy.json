{
  "version": 1,
  "commands": {
    "allow": [
      "git",
      "gh",
      "python3",
      "python",
      "bash",
      "sh",
      "zsh",
      "ls",
      "cat",
      "grep",
      "rg",
      "sed",
      "awk",
      "find",
      "head",
      "tail",
      "wc",
      "sort",
      "uniq",
      "diff",
      "cmp",
      "mkdir",
      "cp",
      "mv",
      "rm",
      "touch",
      "echo",
      "printf",
      "cd",
      "pwd",
      "test",
      "jq",
      "date",
      "sleep",
      "xargs",
      "chmod",
      "ln",
      "readlink",
      "dirname",
      "basename",
      "du",
      "df",
      "ps",
      "lsof",
      "tee",
      "tr",
      "cut",
      "node",
      "npm",
      "npx",
      "pytest",
      "make",
      "true",
      "false",
      "export",
      "set",
      "source",
      "unset",
      "[",
      "[[",
      "if",
      "for",
      "while",
      "do",
      "done",
      "then",
      "fi",
      "else",
      "case",
      "esac",
      "in",
      "time",
      "tar",
      "mktemp"
    ],
    "deny": [
      "git\\s+push\\s+.*--force",
      "git\\s+push\\s+.*\\s-f(\\s|$)",
      "rm\\s+-[a-zA-Z]*r[a-zA-Z]*f?\\s+(/|~|\\$HOME)(\\s|$)",
      "curl\\s+.*\\|\\s*(ba|z)?sh"
    ]
  },
  "paths": {
    "allow": [
      "**"
    ],
    "deny": [
      ".git/**",
      ".env",
      ".env.*",
      ".secrets/**",
      ".githooks/**"
    ]
  },
  "triggers": {
    "gateFailures": 3,
    "deleteFiles": 10,
    "push": true
  }
}
