# Python
__pycache__/
*.py[cod]
venv
.venv

# Environment
.env
.env.*
!.env.example
!.env.local.example
.claude/settings.local.json

*~
.DS_Store

# Auth & Credentials
history.jsonl
auth.json
credentials.json
*.credentials.json
*.key
*.pem

# Staging (active work - never commit to main). Root-anchored on purpose:
# a bare `plans/` also matched docs/plans/, contradicting docs/RULES.md
# which says committed plans live at <repo>/docs/plans/YYYY-MM-DD-<slug>.md.
/staging/
/plans/

# Local databases
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs
*.log
logs/

# Testing
.coverage
.pytest_cache/

# OliverCode public/private runtime boundary
.secrets/*
!.secrets/README.md

# Runtime control plane (local-only agent orchestration state)
runtime/control-plane/**

# Generated runtime manifests (inventory reports, generated status, observability artifacts)
runtime/manifests/

# Local Claude OS: personal memory/state stay local. The framework
# does not depend on any of it (one-directional, per docs/RULES.md).
.claude-optimization/memory/
.claude-optimization/state/

# This machine's paths (scripts/lib/local_config.py). The example is tracked.
olivercode.local.json
shared/repo-profiles.local.json
docs/backlog-config.local.json
# A local file an earlier release wrote into the checkout; nothing writes it now, and a copy that remains stays untracked
docs/LESSONS.jsonl
scratch/

# Hooks that scripts/build-hooks.py builds from core/hooks/ (HOOK-OUTPUTS-1)
/core/templates/project/pre-commit
/core/templates/project/pre-commit-private
/core/templates/project/pre-push
/core/templates/project/commit-msg

# Subagent worktrees that Claude Code creates and removes
.claude/worktrees/

# Local-only audit reports that name fleet repos (story 646)
.claude-optimization/audits/
.claude-optimization/scratch/

# Generated audit reports stay out of the tracked tree
docs/audits/
