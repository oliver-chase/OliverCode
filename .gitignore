# Python
__pycache__/
*.py[cod]
venv/

# Environment
.env
.env.*
!.env.example
!.env.local.example
settings.json
settings.local.json

*~
.DS_Store

# Auth & Credentials
history.jsonl
auth.json
credentials.json
*.credentials.json
*.key
*.pem

# Staging (active work - never commit to main). Root-anchored on purpose:
# a bare `plans/` also matched docs/plans/, contradicting docs/RULES.md
# which says committed plans live at <repo>/docs/plans/YYYY-MM-DD-<slug>.md.
/staging/
/plans/

# Local databases
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs
*.log
logs/

# Testing
.coverage
.pytest_cache/

# OliverCode public/private runtime boundary
.env.local
.secrets/*
!.secrets/README.md

# Runtime control plane (local-only agent orchestration state)
runtime/control-plane/
runtime/control-plane/**

# Generated runtime manifests (inventory reports, generated status, observability artifacts)
runtime/manifests/

# Local Claude OS: personal memory/state stay local. The framework
# does not depend on any of it (one-directional, per docs/RULES.md).
.claude-optimization/memory/
.claude-optimization/state/

# This machine's paths (scripts/lib/local_config.py). The example is tracked.
olivercode.local.json
scratch/
